<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Local Connect | Kathmandu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #ffffff 0%, #e4fbff 100%);
            background-attachment: fixed;
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        }

        /* Subtle floating animation for the Hero Title */
        @keyframes float {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-15px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        .hero-section h1 {
            animation: float 5s ease-in-out infinite;
        }

        .hero-section {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(5px);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Hover effect for the visual cards */
        .feature-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .feature-card img {
            height: 250px;
            object-fit: cover;
            border-radius: 15px;
        }

        .footer-link {
            text-decoration: none;
            color: #444;
            font-size: 0.9rem;
            transition: 0.2s;
        }

        .footer-link:hover {
            color: rgb(255, 174, 24);
            padding-left: 5px;
        }

        .text-orange {
            color: rgb(255, 174, 24);
        }

        .icon-box {
            font-size: 2.5rem;
            margin-bottom: 15px;
            display: inline-block;
        }
    </style>
</head>

<body>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h2 class="fw-bold text-orange m-0">Local Connect</h2>
            <div>
                <a href="/login" class="btn btn-outline-dark me-2 px-4">Log in</a>
                <a href="/register" class="btn btn-success px-4 shadow-sm">Sign up</a>
            </div>
        </div>

        <div class="hero-section shadow-sm mb-5">
            <div class="row g-0 align-items-center">
                <div class="col-md-7">
                    <img src="/images/landing-hero.jpg" alt="Community" class="img-fluid w-100"
                        style="height: 500px; object-fit: cover;">
                </div>
                <div class="col-md-5 p-5 text-center">
                    <h1 class="fw-bold mb-3 text-dark">Connect with your community</h1>
                    <p class="text-muted mb-4 fs-5">Updates, events, volunteering opportunities, and verified
                        organizations in one place.</p>
                    <a href="/register" class="btn btn-success btn-lg px-5 shadow">Get Started</a>
                </div>
            </div>
        </div>



        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="feature-card position-relative text-white card border-0">
                    <img src="/images/organization.jpg" class="card-img" alt="Verified">
                    <div class="position-absolute bottom-0 p-3 bg-dark bg-opacity-50 w-100"
                        style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">
                        <p class="small m-0 font-weight-bold">A secure platform connecting users with verified
                            communities.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card position-relative text-white card border-0">
                    <img src="/images/updates.jpg" class="card-img" alt="Updates">
                    <div class="position-absolute bottom-0 p-3 bg-dark bg-opacity-50 w-100"
                        style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">
                        <p class="small m-0 font-weight-bold">Real-time notices and digital notice boards for your area.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card position-relative text-white card border-0">
                    <img src="/images/engagement.jpg" class="card-img" alt="Action">
                    <div class="position-absolute bottom-0 p-3 bg-dark bg-opacity-50 w-100"
                        style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">
                        <p class="small m-0 font-weight-bold">Support local initiatives and participate in activities.
                        </p>
                    </div>
                </div>
            </div>
        </div>


        <div class="row g-4 mb-5 text-center py-4">
            <div class="col-12">
                <h2 class="fw-bold mb-4">Why Local Connect?</h2>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="icon-box text-success"><i class="bi bi-patch-check"></i></div>
                    <h6 class="fw-bold">Verified Sources</h6>
                    <p class="text-muted small">Every organization and admin is manually verified to eliminate
                        misinformation.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="icon-box text-primary"><i class="bi bi-geo-fill"></i></div>
                    <h6 class="fw-bold">Hyperlocal Feed</h6>
                    <p class="text-muted small">Information tailored to your specific neighborhood and local ward.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="icon-box text-warning"><i class="bi bi-bell-fill"></i></div>
                    <h6 class="fw-bold">Instant Alerts</h6>
                    <p class="text-muted small">Stay updated on water schedules, road closures, and public safety
                        notices.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3">
                    <div class="icon-box text-danger"><i class="bi bi-people-fill"></i></div>
                    <h6 class="fw-bold">Civic Participation</h6>
                    <p class="text-muted small">Easily find and join local volunteering activities and community events.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-top pt-5 pb-5">
            <div class="text-center mb-5">
                <h5 class="fw-bold">Community Engagement & Volunteering Platform</h5>
                <p class="text-muted">Empowering citizens through reliable and accessible community information.</p>
            </div>

            <div class="row text-start">
                <div class="col-md-4 mb-4">
                    <h6 class="text-orange fw-bold mb-3">Platform</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="/about" class="footer-link">· About the Platform</a>
                        <a href="/how-it-works" class="footer-link">· How It Works</a>
                        <a href="/community-guidelines" class="footer-link">· Community Guidelines</a>
                        <a href="/help" class="footer-link">· Help & Support</a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="text-orange fw-bold mb-3">Discover</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="/login" class="footer-link">· Community Notices</a>
                        <a href="/login" class="footer-link">· Events</a>
                        <a href="/login" class="footer-link">· Volunteer Opportunities</a>
                        <a href="/login" class="footer-link">· Verified Organizations</a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="text-orange fw-bold mb-3">For Communities</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="/register" class="footer-link">· Become a Community Admin</a>
                        <a href="/register" class="footer-link">· Register an Organization</a>
                        <a href="/login" class="footer-link">· Admin Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>