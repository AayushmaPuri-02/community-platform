<h2 class="mb-4">Explore Communities</h2>

<% if (profiles.length === 0) { %>
  <p class="text-muted">No organizations or community pages found.</p>
<% } %>

<% profiles.forEach(profile => { %>
  <div class="d-flex align-items-center mb-4 p-3 border rounded shadow-sm" 
       onclick="window.location='/users/<%= profile._id %>'" 
       style="cursor:pointer;">
    
    <!-- Profile Image -->
    <div class="flex-shrink-0 me-4">
      <% if (profile.profileImage) { %>
        <img src="<%= profile.profileImage %>" class="rounded-circle border" width="100" height="100" style="object-fit: cover;">
      <% } else { %>
        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
          <small class="text-muted">No Image</small>
        </div>
      <% } %>
    </div>

    <!-- Profile Info -->
    <div class="flex-grow-1">
      <h4 class="mb-1 text-dark">
        <%= profile.organizationName || profile.fullName %>
      </h4>
      
      <% if (profile.bio) { %>
        <p class="text-muted mb-0 small">
          <%= profile.bio.substring(0, 150) %><%= profile.bio.length > 150 ? '...' : '' %>
        </p>
      <% } %>
    </div>

    <!-- Action Buttons (Static for UI Look) -->
    <div class="ms-3 d-flex gap-2">
      <button class="btn btn-outline-danger btn-sm px-3">Follow</button>
      <button class="btn btn-light btn-sm border text-nowrap" disabled>1k followers</button>
    </div>

  </div>
<% }) %>
