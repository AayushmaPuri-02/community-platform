<% var orgs=profiles.filter(function(p) { return p.role==='organization' ; }); var
  communities=profiles.filter(function(p) { return p.role==='communityAdmin' ; }); %>

  <div style="max-width:1100px; margin:0 auto;">

    <h2 class="mb-4 fw-bold">Explore</h2>

    <div class="row g-4">

      <!-- ── Organizations ──────────────────────────────────────────────── -->
      <div class="col-lg-6">
        <h5 class="fw-bold mb-3"><i class="bi bi-building me-2 text-primary"></i>Organizations</h5>

        <% if (orgs.length===0) { %>
          <p class="text-muted small">No organizations found.</p>
          <% } %>

            <% orgs.forEach(function(p) { %>
              <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-3">

                  <a href="/users/<%= p._id %>" class="flex-shrink-0">
                    <% if (p.profileImage) { %>
                      <img src="<%= p.profileImage %>" class="rounded-circle border"
                        style="width:52px;height:52px;object-fit:cover;">
                      <% } else { %>
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                          style="width:52px;height:52px;">
                          <i class="bi bi-building text-secondary"></i>
                        </div>
                        <% } %>
                  </a>

                  <div class="flex-grow-1 min-width-0">
                    <h6 class="mb-0 fw-bold text-truncate">
                      <a href="/users/<%= p._id %>" class="text-decoration-none text-dark">
                        <%= p.communityName || p.organizationName || p.fullName || 'Unknown' %>
                      </a>
                    </h6>
                    <% if (p.bio) { %>
                      <div class="text-muted small mt-1"
                        style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                        <%= p.bio %>
                      </div>
                      <% } %>
                        <% if (p.location) { %>
                          <div class="text-muted small text-truncate">
                            <i class="bi bi-geo-alt me-1"></i>
                            <%= p.location %>
                          </div>
                          <% } %>
                            <div class="text-muted small">
                              <%= p.followerCount %> follower<%= p.followerCount===1 ? '' : 's' %>
                            </div>
                  </div>

                  <div class="flex-shrink-0">
                    <form action="/follow/<%= p._id %>/toggle" method="POST" class="m-0">
                      <button type="submit"
                        class="btn btn-sm px-3 py-1 <%= p.isFollowing ? 'btn-primary' : 'btn-outline-primary' %>"
                        style="font-size:0.8rem;">
                        <%= p.isFollowing ? 'Following' : 'Follow' %>
                      </button>
                    </form>
                  </div>

                </div>
              </div>
              <% }); %>
      </div>

      <!-- ── Communities ────────────────────────────────────────────────── -->
      <div class="col-lg-6">
        <h5 class="fw-bold mb-3"><i class="bi bi-people me-2 text-success"></i>Communities</h5>

        <% if (communities.length===0) { %>
          <p class="text-muted small">No community pages found.</p>
          <% } %>

            <% communities.forEach(function(p) { %>
              <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-3">

                  <a href="/users/<%= p._id %>" class="flex-shrink-0">
                    <% if (p.profileImage) { %>
                      <img src="<%= p.profileImage %>" class="rounded-circle border"
                        style="width:52px;height:52px;object-fit:cover;">
                      <% } else { %>
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                          style="width:52px;height:52px;">
                          <i class="bi bi-people text-secondary"></i>
                        </div>
                        <% } %>
                  </a>

                  <div class="flex-grow-1 min-width-0">
                    <h6 class="mb-0 fw-bold text-truncate">
                      <a href="/users/<%= p._id %>" class="text-decoration-none text-dark">
                        <%= p.communityName || p.organizationName || p.fullName || 'Unknown' %>
                      </a>
                    </h6>
                    <% if (p.bio) { %>
                      <div class="text-muted small mt-1"
                        style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                        <%= p.bio %>
                      </div>
                      <% } %>
                        <% if (p.location) { %>
                          <div class="text-muted small text-truncate">
                            <i class="bi bi-geo-alt me-1"></i>
                            <%= p.location %>
                          </div>
                          <% } %>
                            <div class="text-muted small">
                              <%= p.followerCount %> follower<%= p.followerCount===1 ? '' : 's' %>
                            </div>
                  </div>

                  <div class="flex-shrink-0">
                    <form action="/follow/<%= p._id %>/toggle" method="POST" class="m-0">
                      <button type="submit"
                        class="btn btn-sm px-3 py-1 <%= p.isFollowing ? 'btn-primary' : 'btn-outline-primary' %>"
                        style="font-size:0.8rem;">
                        <%= p.isFollowing ? 'Following' : 'Follow' %>
                      </button>
                    </form>
                  </div>

                </div>
              </div>
              <% }); %>
      </div>

    </div>
  </div>