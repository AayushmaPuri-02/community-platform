<h2 class="mb-4">Explore Communities & Organizations</h2>

<% if (profiles.length === 0) { %>
  <p class="text-muted">No organizations or community pages found.</p>
<% } %>

<% profiles.forEach(profile => { %>
  <div class="d-flex align-items-center mb-4 p-3 border rounded shadow-sm bg-white">
    
    <!-- Profile Image -->
    <div class="flex-shrink-0 me-4">
      <a href="/users/<%= profile._id %>">
        <% if (profile.profileImage) { %>
          <img
            src="<%= profile.profileImage %>"
            class="rounded-circle border"
            width="100"
            height="100"
            style="object-fit: cover;"
          >
        <% } else { %>
          <div
            class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
            style="width: 100px; height: 100px;"
          >
            <small class="text-muted">No Image</small>
          </div>
        <% } %>
      </a>
    </div>

    <!-- Profile Info -->
    <div class="flex-grow-1">
      <h4 class="mb-1">
        <a href="/users/<%= profile._id %>" class="text-dark text-decoration-none">
          <%= profile.organizationName || profile.fullName %>
        </a>
      </h4>

      <% if (profile.bio) { %>
        <p class="text-muted mb-2 small">
          <%= profile.bio.substring(0, 150) %><%= profile.bio.length > 150 ? "..." : "" %>
        </p>
      <% } %>

      <small class="text-muted">
        <%= profile.followerCount %> follower<%= profile.followerCount === 1 ? "" : "s" %>
      </small>
    </div>

    <!-- Follow Action -->
    <div class="ms-3 d-flex gap-2 align-items-center">
      <form action="/follow/<%= profile._id %>/toggle" method="POST" class="m-0">
        <button
          type="submit"
          class="btn btn-sm px-3 <%= profile.isFollowing ? 'btn-primary' : 'btn-outline-primary' %>"
        >
          <%= profile.isFollowing ? "Following" : "Follow" %>
        </button>
      </form>
    </div>
  </div>
<% }) %>