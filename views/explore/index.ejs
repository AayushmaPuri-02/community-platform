<% var orgs=profiles.filter(function(p) { return p.role==='organization' ; }); var
  communities=profiles.filter(function(p) { return p.role==='communityAdmin' ; }); %>

  <div style="max-width:1100px; margin:0 auto;">

    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
      <h2 class="mb-0 fw-bold">Explore</h2>
      <div class="position-relative" style="width:100%; max-width:360px;">
        <i class="bi bi-search position-absolute text-muted"
          style="left:12px; top:50%; transform:translateY(-50%); font-size:14px;"></i>
        <input type="search" id="exploreSearch" class="form-control ps-5 rounded-pill border shadow-sm"
          placeholder="Search organizations and communities..." autocomplete="off"
          aria-label="Search organizations and communities">
      </div>
    </div>

    <p id="exploreSearchEmpty" class="text-muted small text-center py-4" style="display:none;">
      No organizations or communities match your search.
    </p>

    <div class="row g-4" id="exploreColumns">

      <!-- ── Organizations ──────────────────────────────────────────────── -->
      <div class="col-lg-6">
        <h5 class="fw-bold mb-3"><i class="bi bi-building me-2 text-primary"></i>Organizations</h5>

        <p id="exploreOrgsEmpty" class="text-muted small <%= orgs.length === 0 ? '' : 'd-none' %>">No organizations found.</p>

            <% orgs.forEach(function(p) { var displayName=(p.communityName || p.organizationName || p.fullName || 'Unknown'); %>
              <div class="card border-0 shadow-sm mb-3 explore-profile-card" style="border-radius:12px;"
                data-search-name="<%= displayName.toLowerCase() %>" data-role="organization">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-3">

                  <a href="/users/<%= p._id %>" class="flex-shrink-0">
                    <% if (p.profileImage) { %>
                      <img src="<%= p.profileImage %>" class="rounded-circle border"
                        style="width:52px;height:52px;object-fit:cover;">
                      <% } else { %>
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                          style="width:52px;height:52px;">
                          <i class="bi bi-building text-secondary"></i>
                        </div>
                        <% } %>
                  </a>

                  <div class="flex-grow-1 min-width-0">
                    <h6 class="mb-0 fw-bold text-truncate">
                      <a href="/users/<%= p._id %>" class="text-decoration-none text-dark">
                        <%= displayName %>
                      </a>
                    </h6>
                    <% if (p.bio) { %>
                      <div class="text-muted small mt-1"
                        style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                        <%= p.bio %>
                      </div>
                      <% } %>
                        <% if (p.location) { %>
                          <div class="text-muted small text-truncate">
                            <i class="bi bi-geo-alt me-1"></i>
                            <%= p.location %>
                          </div>
                          <% } %>
                            <div class="text-muted small">
                              <%= p.followerCount %> follower<%= p.followerCount===1 ? '' : 's' %>
                            </div>
                  </div>

                  <div class="flex-shrink-0">
                    <form action="/follow/<%= p._id %>/toggle" method="POST" class="m-0">
                      <button type="submit"
                        class="btn btn-sm px-3 py-1 <%= p.isFollowing ? 'btn-primary' : 'btn-outline-primary' %>"
                        style="font-size:0.8rem;">
                        <%= p.isFollowing ? 'Following' : 'Follow' %>
                      </button>
                    </form>
                  </div>

                </div>
              </div>
              <% }); %>
      </div>

      <!-- ── Communities ────────────────────────────────────────────────── -->
      <div class="col-lg-6">
        <h5 class="fw-bold mb-3"><i class="bi bi-people me-2 text-success"></i>Communities</h5>

        <p id="exploreCommunitiesEmpty" class="text-muted small <%= communities.length === 0 ? '' : 'd-none' %>">No community pages found.</p>

            <% communities.forEach(function(p) { var displayName=(p.communityName || p.organizationName || p.fullName || 'Unknown'); %>
              <div class="card border-0 shadow-sm mb-3 explore-profile-card" style="border-radius:12px;"
                data-search-name="<%= displayName.toLowerCase() %>" data-role="community">
                <div class="card-body d-flex align-items-center gap-3 py-3 px-3">

                  <a href="/users/<%= p._id %>" class="flex-shrink-0">
                    <% if (p.profileImage) { %>
                      <img src="<%= p.profileImage %>" class="rounded-circle border"
                        style="width:52px;height:52px;object-fit:cover;">
                      <% } else { %>
                        <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                          style="width:52px;height:52px;">
                          <i class="bi bi-people text-secondary"></i>
                        </div>
                        <% } %>
                  </a>

                  <div class="flex-grow-1 min-width-0">
                    <h6 class="mb-0 fw-bold text-truncate">
                      <a href="/users/<%= p._id %>" class="text-decoration-none text-dark">
                        <%= displayName %>
                      </a>
                    </h6>
                    <% if (p.bio) { %>
                      <div class="text-muted small mt-1"
                        style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                        <%= p.bio %>
                      </div>
                      <% } %>
                        <% if (p.location) { %>
                          <div class="text-muted small text-truncate">
                            <i class="bi bi-geo-alt me-1"></i>
                            <%= p.location %>
                          </div>
                          <% } %>
                            <div class="text-muted small">
                              <%= p.followerCount %> follower<%= p.followerCount===1 ? '' : 's' %>
                            </div>
                  </div>

                  <div class="flex-shrink-0">
                    <form action="/follow/<%= p._id %>/toggle" method="POST" class="m-0">
                      <button type="submit"
                        class="btn btn-sm px-3 py-1 <%= p.isFollowing ? 'btn-primary' : 'btn-outline-primary' %>"
                        style="font-size:0.8rem;">
                        <%= p.isFollowing ? 'Following' : 'Follow' %>
                      </button>
                    </form>
                  </div>

                </div>
              </div>
              <% }); %>
      </div>

    </div>
  </div>

  <script>
    (function () {
      var input = document.getElementById('exploreSearch');
      var cards = document.querySelectorAll('.explore-profile-card');
      var globalEmpty = document.getElementById('exploreSearchEmpty');
      var orgsEmpty = document.getElementById('exploreOrgsEmpty');
      var communitiesEmpty = document.getElementById('exploreCommunitiesEmpty');
      var hasOrgCards = document.querySelector('.explore-profile-card[data-role="organization"]');
      var hasCommunityCards = document.querySelector('.explore-profile-card[data-role="community"]');

      if (!input) return;

      function filterExplore() {
        var query = input.value.trim().toLowerCase();
        var visibleOrgs = 0;
        var visibleCommunities = 0;

        cards.forEach(function (card) {
          var name = card.getAttribute('data-search-name') || '';
          var match = !query || name.indexOf(query) !== -1;
          card.style.display = match ? '' : 'none';
          if (!match) return;
          if (card.getAttribute('data-role') === 'community') visibleCommunities++;
          else visibleOrgs++;
        });

        var visibleTotal = visibleOrgs + visibleCommunities;

        if (globalEmpty) {
          globalEmpty.style.display = query && visibleTotal === 0 ? '' : 'none';
        }
        if (orgsEmpty && hasOrgCards) {
          orgsEmpty.classList.toggle('d-none', visibleOrgs > 0);
          orgsEmpty.textContent = query
            ? 'No organizations match your search.'
            : 'No organizations found.';
        }
        if (communitiesEmpty && hasCommunityCards) {
          communitiesEmpty.classList.toggle('d-none', visibleCommunities > 0);
          communitiesEmpty.textContent = query
            ? 'No communities match your search.'
            : 'No community pages found.';
        }
      }

      input.addEventListener('input', filterExplore);
    })();
  </script>
