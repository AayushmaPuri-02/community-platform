<div class="container py-4" style="max-width: 900px;">
  <h2 class="mb-4">Messages</h2>

  <% if (conversations.length === 0) { %>
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body p-4">
        <p class="text-muted mb-0">No conversations yet.</p>
      </div>
    </div>
  <% } %>

  <% conversations.forEach(item => { %>
    <a href="/messages/<%= item.user._id %>" class="text-decoration-none">
      <div class="card mb-3 border-0 shadow-sm rounded-4 <%= item.hasUnread ? 'border border-warning-subtle bg-warning bg-opacity-10' : '' %>">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3">
            <% if (item.user.profileImage) { %>
              <img
                src="<%= item.user.profileImage %>"
                alt="User"
                class="rounded-circle border"
                style="width:52px; height:52px; object-fit:cover;"
              >
            <% } else { %>
              <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width:52px; height:52px;">
                <i class="bi bi-person text-secondary"></i>
              </div>
            <% } %>

            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h6 class="mb-1 fw-bold text-dark">
                    <%= item.user.organizationName || item.user.fullName %>
                  </h6>
                  <p class="text-muted mb-0 small">
                    <%= item.latestMessage && item.latestMessage.length > 55 ? item.latestMessage.substring(0, 55) + "..." : item.latestMessage %>
                  </p>
                </div>

                <div class="text-end">
                  <small class="text-muted d-block">
                    <%= new Date(item.latestMessageTime).toLocaleDateString("en-GB", {
                      day: "numeric",
                      month: "short",
                      year: "numeric"
                    }) %>
                  </small>

                  <% if (item.hasUnread) { %>
                    <span class="badge bg-warning text-dark mt-2">New</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </a>
  <% }) %>
</div>