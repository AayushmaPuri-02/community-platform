<div class="container py-4">
  <div class="row g-4">
    <!-- LEFT: CONVERSATION LIST -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-3">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold">Messages</h5>
            <a href="/messages" class="btn btn-outline-secondary btn-sm">Inbox</a>
          </div>

          <% if (conversations.length===0) { %>
            <p class="text-muted mb-0">No conversations yet.</p>
            <% } %>

              <div class="d-flex flex-column gap-2">
                <% conversations.forEach(item=> { %>
                  <a href="/messages/<%= item.user._id %>" class="text-decoration-none">
                    <div
                      class="p-3 rounded-4 border <%= item.user._id.toString() === otherUser.toString() ? 'bg-light border-primary' : 'bg-white' %>">
                      <div class="d-flex align-items-center gap-3">
                        <% if (item.user.profileImage) { %>
                          <img src="<%= item.user.profileImage %>" alt="User" class="rounded-circle border"
                            style="width:46px; height:46px; object-fit:cover;">
                          <% } else { %>
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                              style="width:46px; height:46px;">
                              <i class="bi bi-person text-secondary"></i>
                            </div>
                            <% } %>

                              <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                  <div>
                                    <div class="fw-semibold text-dark d-inline-flex align-items-center flex-wrap gap-1">
                                      <span><%= item.user.communityName || item.user.organizationName || item.user.fullName %></span>
                                      <%- include('../partials/volunteerBadge', { user: item.user }) %>
                                    </div>
                                    <div class="small text-muted">
                                      <%= item.latestMessage && item.latestMessage.length> 30 ?
                                        item.latestMessage.substring(0, 30) + "..." : item.latestMessage %>
                                    </div>
                                  </div>

                                  <% if (item.hasUnread && item.user._id.toString() !==otherUser.toString()) { %>
                                    <span class="badge bg-warning text-dark">New</span>
                                    <% } %>
                                </div>
                              </div>
                      </div>
                    </div>
                  </a>
                  <% }) %>
              </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: ACTIVE CHAT -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 p-3 rounded-top-4">
          <div class="d-flex align-items-center gap-3">
            <a href="/users/<%= otherUser %>" class="flex-shrink-0 text-decoration-none">
              <% if (otherUserData.profileImage) { %>
                <img src="<%= otherUserData.profileImage %>" alt="User" class="rounded-circle border"
                  style="width:52px; height:52px; object-fit:cover;">
                <% } else { %>
                  <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                    style="width:52px; height:52px;">
                    <i class="bi bi-person text-secondary"></i>
                  </div>
                  <% } %>
            </a>

            <div>
              <h5 class="mb-0 fw-bold d-inline-flex align-items-center flex-wrap gap-1">
                <a href="/users/<%= otherUser %>" class="text-decoration-none text-dark d-inline-flex align-items-center flex-wrap gap-1">
                  <span><%= otherUserData.communityName || otherUserData.organizationName || otherUserData.fullName %></span>
                  <%- include('../partials/volunteerBadge', { user: otherUserData }) %>
                </a>
              </h5>
              <small class="text-muted">Conversation</small>
            </div>
          </div>
        </div>

        <div id="chatBox" class="card-body p-3" style="height: 480px; overflow-y: auto; background: #fcfcfc;">
          <% if (messages.length===0) { %>
            <p class="text-muted">No messages yet. Start the conversation.</p>
            <% } %>

              <% messages.forEach(msg=> { %>
                <% const isMine=msg.sender._id.toString()===userId.toString(); %>
                  <% const avatar=msg.sender.profileImage ? msg.sender.profileImage : "/images/default-avatar.png" ; %>

                    <div class="mb-3 d-flex <%= isMine ? 'justify-content-end' : 'justify-content-start' %>">
                      <div class="d-flex align-items-end gap-2 <%= isMine ? 'flex-row-reverse' : '' %>"
                        style="max-width: 80%;">
                        <img src="<%= avatar %>" alt="User" class="rounded-circle border"
                          style="width:36px; height:36px; object-fit:cover;">

                        <div>
                          <% if (msg.isDeleted) { %>
                            <div class="px-3 py-2 rounded-4 fst-italic text-muted"
                              style="background:#f1f3f5; word-break: break-word;">
                              <%= isMine ? "You deleted this message" : "Message deleted" %>
                            </div>
                            <% } else { %>
                              <div class="px-3 py-2 rounded-4 msg-bubble"
                                style="background:<%= isMine ? '#dbeafe' : '#f1f3f5' %>; word-break: break-word; max-width: 100%; overflow: hidden;">
                                <% if (msg.imageUrl) { %>
                                  <img src="<%= msg.imageUrl %>" alt="Shared image" class="msg-image-preview <%= msg.text ? 'mb-2' : '' %>">
                                <% } %>
                                <% if (msg.text) { %>
                                  <div class="msg-text"><%= msg.text %></div>
                                <% } %>
                              </div>
                              <% } %>

                                <div
                                  class="d-flex align-items-center gap-2 mt-1 <%= isMine ? 'justify-content-end' : 'justify-content-start' %>">
                                  <small class="text-muted msg-timestamp">
                                    <% const msgDate=new Date(msg.createdAt); const now=new Date(); const
                                      isToday=msgDate.getDate()===now.getDate() && msgDate.getMonth()===now.getMonth()
                                      && msgDate.getFullYear()===now.getFullYear(); %>

                                      <% if (isToday) { %>
                                        <%= msgDate.toLocaleTimeString("en-GB", { hour: "numeric" , minute: "2-digit" ,
                                          hour12: true }) %>
                                          <% } else { %>
                                            <%= msgDate.toLocaleString("en-GB", { day: "numeric" , month: "short" ,
                                              year: "numeric" , hour: "numeric" , minute: "2-digit" , hour12: true }) %>
                                              <% } %>
                                  </small>

                                  <% if (isMine && !msg.isDeleted) { %>
                                    <button type="button"
                                      class="btn btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center border-0"
                                      style="width:24px; height:24px; background:#ffe5e5; color:#dc3545;"
                                      title="Delete message" data-bs-toggle="modal" data-bs-target="#deleteMessageModal"
                                      data-message-id="<%= msg._id %>">
                                      <i class="bi bi-trash msg-action-icon"></i>
                                    </button>
                                    <% } %>
                                </div>
                        </div>
                      </div>
                    </div>
                    <% }) %>
        </div>

        <div class="card-footer bg-white border-0 p-3 rounded-bottom-4">
          <form id="messageForm" method="POST" action="/messages/<%= otherUser %>" enctype="multipart/form-data">
            <div class="input-group">
              <input type="text" name="text" class="form-control" placeholder="Type a message...">
              <label for="messageImageInput" class="btn btn-outline-secondary mb-0" title="Attach image">
                <i class="bi bi-image"></i>
              </label>
              <input type="file" name="messageImage" id="messageImageInput" class="d-none"
                accept="image/jpeg,image/jpg,image/png,image/webp">
              <button type="submit" class="btn btn-primary px-4">Send</button>
            </div>
            <small id="messageImageHint" class="text-muted d-none mt-2"></small>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- DELETE MESSAGE MODAL -->
<div class="modal fade" id="deleteMessageModal" tabindex="-1" aria-labelledby="deleteMessageModalLabel"
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="deleteMessageModalLabel">Delete Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-2">
        <p class="mb-2" style="font-size: 1rem;">
          Are you sure you want to delete this message?
        </p>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">
          This action cannot be undone.
        </p>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>

        <form id="deleteMessageForm" method="POST" class="m-0">
          <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .msg-image-preview {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>

<script>
  const chatBox = document.getElementById("chatBox");
  if (chatBox) {
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  const deleteMessageForm = document.getElementById("deleteMessageForm");

  document.querySelectorAll('[data-bs-target="#deleteMessageModal"]').forEach(button => {
    button.addEventListener("click", () => {
      const messageId = button.getAttribute("data-message-id");
      deleteMessageForm.action = `/messages/${messageId}/delete`;
    });
  });

  const messageForm = document.getElementById("messageForm");
  const messageImageInput = document.getElementById("messageImageInput");
  const messageImageHint = document.getElementById("messageImageHint");

  if (messageImageInput) {
    messageImageInput.addEventListener("change", function () {
      if (messageImageInput.files.length > 0) {
        messageImageHint.textContent = "Attached: " + messageImageInput.files[0].name;
        messageImageHint.classList.remove("d-none");
      } else {
        messageImageHint.textContent = "";
        messageImageHint.classList.add("d-none");
      }
    });
  }

  if (messageForm) {
    messageForm.addEventListener("submit", function (e) {
      const text = messageForm.querySelector('[name="text"]').value.trim();
      const hasImage = messageImageInput && messageImageInput.files.length > 0;
      if (!text && !hasImage) {
        e.preventDefault();
      }
    });
  }

  // Convert plain URLs in message text to clickable links
  document.querySelectorAll('.msg-text').forEach(function (el) {
    var text = el.textContent;
    var urlPattern = /(https?:\/\/[^\s]+)/g;
    if (!urlPattern.test(text)) return;
    el.innerHTML = el.innerHTML.replace(/(https?:\/\/[^\s<]+)/g, function (url) {
      var a = document.createElement('a');
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener';
      a.style.color = '#1d4ed8';
      a.style.wordBreak = 'break-all';
      a.textContent = url;
      return a.outerHTML;
    });
  });
</script>