<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
      <div class="card border-info shadow-lg overflow-hidden">
        <div class="row g-0">

          <!-- Left Side Image -->
          <div class="col-md-5 d-none d-md-block position-relative">
            <span class="position-absolute top-0 start-0 p-3 text-info fw-bold" style="z-index: 10;">
              User Registration
            </span>
            <img src="/images/registerimage.jpg" class="w-100 h-100" style="object-fit: cover; min-height: 700px;"
              alt="Connection">
          </div>

          <!-- Right Side Form -->
          <div class="col-md-7 bg-white p-5 d-flex flex-column justify-content-center text-center">

            <div class="mb-4">
              <h2 class="d-inline-block px-4 py-2 border rounded-pill text-warning shadow-sm"
                style="font-family: serif;">
                Local Connect
              </h2>
              <p class="text-muted small mt-2">
                Connect with your community — updates, events, and more.
              </p>
            </div>

            <h4 class="fw-bold mb-4">Register</h4>

            <form action="/register" method="POST" enctype="multipart/form-data">

              <!-- Role Buttons -->
              <div class="btn-group w-100 mb-4" role="group">
                <input type="radio" class="btn-check" name="role" id="user" value="citizen" <%=(!formData.role ||
                  formData.role==='citizen' ) ? 'checked' : '' %>>
                <label class="btn btn-outline-secondary py-2" for="user">User</label>

                <input type="radio" class="btn-check" name="role" id="org" value="organization"
                  <%=formData.role==='organization' ? 'checked' : '' %>>
                <label class="btn btn-outline-secondary py-2" for="org">Organization</label>

                <input type="radio" class="btn-check" name="role" id="admin" value="communityAdmin"
                  <%=formData.role==='communityAdmin' ? 'checked' : '' %>>
                <label class="btn btn-outline-secondary py-2" for="admin">Community Admin</label>
              </div>

              <!-- Citizen / Common Name -->
              <div class="mb-3 row align-items-center text-start" id="fullNameField">
                <label class="col-sm-4 fw-bold">Full Name :</label>
                <div class="col-sm-8">
                  <input type="text" name="fullName" class="form-control" placeholder="Enter your full name"
                    value="<%= formData.fullName || '' %>" maxlength="60">
                </div>
              </div>

              <!-- Organization Name -->
              <div class="mb-3 row align-items-center text-start d-none" id="organizationNameField">
                <label class="col-sm-4 fw-bold">Organization :</label>
                <div class="col-sm-8">
                  <input type="text" name="organizationName" class="form-control" placeholder="Enter organization name"
                    value="<%= formData.organizationName || '' %>" maxlength="100">
                </div>
              </div>

              <!-- Email -->
              <div class="mb-3 row align-items-center text-start">
                <label class="col-sm-4 fw-bold">Email :</label>
                <div class="col-sm-8">
                  <input type="email" name="email" class="form-control" placeholder="your@gmail.com" required
                    value="<%= formData.email || '' %>">
                </div>
              </div>

              <!-- Password -->
              <div class="mb-3 row align-items-center text-start">
                <label class="col-sm-4 fw-bold">Password :</label>
                <div class="col-sm-8">
                  <input type="password" name="password" class="form-control" placeholder="........" required>
                </div>
              </div>

              <!-- Confirm Password -->
              <div class="mb-3 row align-items-center text-start">
                <label class="col-sm-4 fw-bold">Confirm :</label>
                <div class="col-sm-8">
                  <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter password"
                    required>
                </div>
              </div>

              <!-- Location (citizen / org: free text) -->
              <div class="mb-3 row align-items-center text-start" id="locationTextField">
                <label class="col-sm-4 fw-bold">Location :</label>
                <div class="col-sm-8">
                  <div class="input-group">
                    <input type="text" id="registerLocationInput" name="location" class="form-control"
                      placeholder="Search your area or street address in Nepal" value="<%= formData.location || '' %>">
                    <button type="button" id="searchRegisterLocationBtn" class="btn btn-outline-secondary">
                      Search
                    </button>
                  </div>
                  <div id="registerLocationError" class="text-danger small mt-1" style="display:none;"></div>
                </div>
              </div>

              <!-- Location (communityAdmin: dropdown) -->
              <div class="mb-3 row align-items-center text-start d-none" id="locationDropdownField">
                <label class="col-sm-4 fw-bold">Location :</label>
                <div class="col-sm-8">
                  <select name="locationDropdown" class="form-control" id="locationSelect">
                    <option value="">-- Select your area --</option>
                    <% var
                      areas=["Kalanki","Baneshwor","Koteshwor","Balaju","Chabahil","Kirtipur","Bhaktapur","Lalitpur","Patan","Thamel","Boudha","Gongabu","Sitapaila","Swayambhu","Naxal","Maharajgunj","Lazimpat","Dillibazar","Putalisadak","Jawalakhel"];
                      %>
                      <% areas.forEach(function(area) { %>
                        <% var taken=unavailableCommunityAreas && unavailableCommunityAreas.includes(area); %>
                          <option value="<%= area %>" <%=formData.locationDropdown===area ? 'selected' : '' %>
                            <%= taken ? 'disabled' : '' %>
                              ><%= area %>
                                <%= taken ? ' (Already assigned)' : '' %>
                          </option>
                          <% }); %>
                  </select>
                  <div class="form-text">Your public page will be named "<span id="communityNamePreview">Location</span>
                    Locals"</div>
                </div>
              </div>

              <!-- Community Admin Mobile -->
              <div class="mb-3 row align-items-center text-start d-none" id="mobileNumberField">
                <label class="col-sm-4 fw-bold">Mobile No :</label>
                <div class="col-sm-8">
                  <input type="text" name="mobileNumber" id="mobileNumberInput" class="form-control"
                    placeholder="e.g. 9812345678" value="<%= formData.mobileNumber || '' %>">
                  <div class="form-text">Must start with 97 or 98, 10 digits total.</div>
                  <div class="invalid-feedback" id="mobileError">Enter a valid Nepal mobile number (e.g. 9812345678).
                  </div>
                </div>
              </div>

              <!-- Organization Social Media -->
              <div class="mb-3 row align-items-center text-start d-none" id="socialMediaField">
                <label class="col-sm-4 fw-bold">Social Link :</label>
                <div class="col-sm-8">
                  <input type="text" name="socialMediaLink" class="form-control"
                    placeholder="Facebook / Instagram / Website" value="<%= formData.socialMediaLink || '' %>">
                </div>
              </div>

              <!-- Verification Document -->
              <div class="mb-4 row align-items-center text-start d-none" id="verificationDocField">
                <label class="col-sm-4 fw-bold">Verification :</label>
                <div class="col-sm-8">
                  <input type="file" name="verificationDoc" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
                  <div class="form-text">Upload a registration certificate, official letter, or government-issued
                    document (PDF, JPG, PNG).</div>
                </div>
              </div>

              <!-- Profile Image (communityAdmin only) -->
              <div class="mb-4 row align-items-center text-start d-none" id="profileImageField">
                <label class="col-sm-4 fw-bold">Profile Image :</label>
                <div class="col-sm-8">
                  <input type="file" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png">
                  <div class="form-text">Required. Upload a clear profile photo.</div>
                </div>
              </div>

              <!-- Hidden structured location fields — populated by geocoder in next step -->
              <input type="hidden" id="locationNameInput" name="locationName"
                value="<%= formData.locationName  || '' %>">
              <input type="hidden" id="homeLatitudeInput" name="homeLatitude"
                value="<%= formData.homeLatitude  || '' %>">
              <input type="hidden" id="homeLongitudeInput" name="homeLongitude"
                value="<%= formData.homeLongitude || '' %>">

              <button type="submit" class="btn w-50 py-2 text-white fw-bold shadow-sm"
                style="background-color: #008080;">
                REGISTER
              </button>
            </form>

            <p class="mt-4 small">
              Already have an account?
              <a href="/login" class="text-success fw-bold text-decoration-none">login</a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<script>
  var citizenRadio = document.getElementById("user");
  var orgRadio = document.getElementById("org");
  var adminRadio = document.getElementById("admin");

  var fullNameField = document.getElementById("fullNameField");
  var organizationNameField = document.getElementById("organizationNameField");
  var mobileNumberField = document.getElementById("mobileNumberField");
  var socialMediaField = document.getElementById("socialMediaField");
  var verificationDocField = document.getElementById("verificationDocField");
  var locationTextField = document.getElementById("locationTextField");
  var locationDropdownField = document.getElementById("locationDropdownField");
  var profileImageField = document.getElementById("profileImageField");
  var locationSelect = document.getElementById("locationSelect");
  var communityNamePreview = document.getElementById("communityNamePreview");

  function updateFields() {
    if (citizenRadio.checked) {
      fullNameField.classList.remove("d-none");
      organizationNameField.classList.add("d-none");
      mobileNumberField.classList.add("d-none");
      socialMediaField.classList.add("d-none");
      verificationDocField.classList.add("d-none");
      locationTextField.classList.remove("d-none");
      locationDropdownField.classList.add("d-none");
      profileImageField.classList.add("d-none");
    }
    if (orgRadio.checked) {
      fullNameField.classList.add("d-none");
      organizationNameField.classList.remove("d-none");
      mobileNumberField.classList.add("d-none");
      socialMediaField.classList.remove("d-none");
      verificationDocField.classList.remove("d-none");
      locationTextField.classList.remove("d-none");
      locationDropdownField.classList.add("d-none");
      profileImageField.classList.add("d-none");
    }
    if (adminRadio.checked) {
      fullNameField.classList.remove("d-none");
      organizationNameField.classList.add("d-none");
      mobileNumberField.classList.remove("d-none");
      socialMediaField.classList.add("d-none");
      verificationDocField.classList.remove("d-none");
      locationTextField.classList.add("d-none");
      locationDropdownField.classList.remove("d-none");
      profileImageField.classList.remove("d-none");
    }
  }

  locationSelect.addEventListener("change", function () {
    communityNamePreview.textContent = this.value || "Location";
  });

  citizenRadio.addEventListener("change", updateFields);
  orgRadio.addEventListener("change", updateFields);
  adminRadio.addEventListener("change", updateFields);

  // If backend redirected back with ?role=communityAdmin, pre-select that tab
  var urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get("role") === "communityAdmin") {
    adminRadio.checked = true;
  }
  updateFields();

  // ---- communityAdmin client-side validation ----
  var nepalMobileRegex = /^(97|98)\d{8}$/;

  function validateCommunityAdminForm() {
    if (!adminRadio.checked) return true;

    var valid = true;

    var fullNameInput = document.querySelector('input[name="fullName"]');
    if (!fullNameInput.value.trim()) {
      fullNameInput.classList.add("is-invalid");
      valid = false;
    } else {
      fullNameInput.classList.remove("is-invalid");
    }

    var emailInput = document.querySelector('input[name="email"]');
    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(emailInput.value.trim())) {
      emailInput.classList.add("is-invalid");
      valid = false;
    } else {
      emailInput.classList.remove("is-invalid");
    }

    var passwordInput = document.querySelector('input[name="password"]');
    if (passwordInput.value.length < 8 || !/[a-zA-Z]/.test(passwordInput.value) || !/[0-9]/.test(passwordInput.value) || !/[@#$%&*!]/.test(passwordInput.value)) {
      passwordInput.classList.add("is-invalid");
      valid = false;
    } else {
      passwordInput.classList.remove("is-invalid");
    }

    var confirmInput = document.querySelector('input[name="confirmPassword"]');
    if (confirmInput.value !== passwordInput.value) {
      confirmInput.classList.add("is-invalid");
      valid = false;
    } else {
      confirmInput.classList.remove("is-invalid");
    }

    if (!locationSelect.value) {
      locationSelect.classList.add("is-invalid");
      valid = false;
    } else {
      locationSelect.classList.remove("is-invalid");
    }

    var mobileInput = document.getElementById("mobileNumberInput");
    var mobileError = document.getElementById("mobileError");
    if (!nepalMobileRegex.test(mobileInput.value.trim())) {
      mobileInput.classList.add("is-invalid");
      valid = false;
    } else {
      mobileInput.classList.remove("is-invalid");
    }

    var verificationDocInput = document.querySelector('input[name="verificationDoc"]');
    if (!verificationDocInput.files || verificationDocInput.files.length === 0) {
      verificationDocInput.classList.add("is-invalid");
      valid = false;
    } else {
      verificationDocInput.classList.remove("is-invalid");
    }

    var profileImageInput = document.querySelector('input[name="profileImage"]');
    if (!profileImageInput.files || profileImageInput.files.length === 0) {
      profileImageInput.classList.add("is-invalid");
      valid = false;
    } else {
      profileImageInput.classList.remove("is-invalid");
    }

    return valid;
  }

  // Live validation on mobile input
  var mobileInput = document.getElementById("mobileNumberInput");
  if (mobileInput) {
    mobileInput.addEventListener("input", function () {
      if (nepalMobileRegex.test(this.value.trim())) {
        this.classList.remove("is-invalid");
        this.classList.add("is-valid");
      } else {
        this.classList.remove("is-valid");
        if (this.value.length > 0) this.classList.add("is-invalid");
      }
    });
  }

  document.querySelector("form").addEventListener("submit", function (e) {
    if (adminRadio.checked && !validateCommunityAdminForm()) {
      e.preventDefault();
    }

    // Location required for citizen and organization
    if (!adminRadio.checked) {
      var nameVal = document.getElementById('locationNameInput').value;
      var latVal = document.getElementById('homeLatitudeInput').value;
      var lngVal = document.getElementById('homeLongitudeInput').value;
      if (!nameVal || !latVal || !lngVal) {
        e.preventDefault();
        var errEl = document.getElementById('registerLocationError');
        errEl.textContent = 'Please search and select a valid location in Nepal.';
        errEl.style.color = '#dc3545';
        errEl.style.display = 'block';
        document.getElementById('registerLocationInput').focus();
      }
    }
  });
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&loading=async"></script>

<script>
  (function () {
    var searchBtn = document.getElementById('searchRegisterLocationBtn');
    var input = document.getElementById('registerLocationInput');
    var errorDiv = document.getElementById('registerLocationError');
    var nameInput = document.getElementById('locationNameInput');
    var latInput = document.getElementById('homeLatitudeInput');
    var lngInput = document.getElementById('homeLongitudeInput');

    if (!searchBtn || !input) return;

    searchBtn.addEventListener('click', function () {
      var query = input.value.trim();
      if (!query) {
        errorDiv.textContent = 'Please enter a location to search.';
        errorDiv.style.color = '#dc3545';
        errorDiv.style.display = 'block';
        return;
      }

      if (!/nepal/i.test(query)) {
        query = query + ', Nepal';
      }

      searchBtn.disabled = true;
      searchBtn.textContent = 'Searching\u2026';

      var geocoder = new google.maps.Geocoder();
      geocoder.geocode({ address: query }, function (results, status) {
        searchBtn.disabled = false;
        searchBtn.textContent = 'Search';

        if (status !== 'OK' || !results || results.length === 0) {
          nameInput.value = '';
          latInput.value = '';
          lngInput.value = '';
          errorDiv.textContent = 'Please enter a valid location in Nepal.';
          errorDiv.style.color = '#dc3545';
          errorDiv.style.display = 'block';
          return;
        }

        var loc = results[0].geometry.location;
        var lat = loc.lat();
        var lng = loc.lng();

        if (lat < 26.3 || lat > 30.5 || lng < 80.0 || lng > 88.5) {
          nameInput.value = '';
          latInput.value = '';
          lngInput.value = '';
          errorDiv.textContent = 'Please enter a valid location in Nepal.';
          errorDiv.style.color = '#dc3545';
          errorDiv.style.display = 'block';
          return;
        }

        var address = results[0].formatted_address;
        nameInput.value = address;
        latInput.value = lat;
        lngInput.value = lng;
        input.value = address;
        errorDiv.textContent = 'Location selected.';
        errorDiv.style.color = '#198754';
        errorDiv.style.display = 'block';
      });
    });
  })();
</script>

<script>
  (function () {
    // ── Helpers ────────────────────────────────────────────────────────────────
    function showMsg(el, text, isError) {
      if (!el) return;
      el.textContent = text;
      el.style.color = isError ? '#dc3545' : '#198754';
      el.style.display = text ? 'block' : 'none';
    }

    function injectMsg(afterEl, id) {
      var existing = document.getElementById(id);
      if (existing) return existing;
      var div = document.createElement('div');
      div.id = id;
      div.style.cssText = 'font-size:12px; margin-top:4px; display:none;';
      afterEl.parentNode.insertBefore(div, afterEl.nextSibling);
      return div;
    }

    // ── Password live validation ───────────────────────────────────────────────
    var pwInput = document.querySelector('input[name="password"]');
    var confirmInput = document.querySelector('input[name="confirmPassword"]');

    if (pwInput && confirmInput) {
      var pwMsg = injectMsg(pwInput, 'pwFeedback');
      var confirmMsg = injectMsg(confirmInput, 'confirmFeedback');

      pwInput.addEventListener('input', function () {
        var val = this.value;
        var tooShort = val.length > 0 && val.length < 8;
        var noLetter = val.length > 0 && !/[a-zA-Z]/.test(val);
        var noNumber = val.length > 0 && !/[0-9]/.test(val);
        var noSpecial = val.length > 0 && !/[@#$%&*!]/.test(val);
        if (tooShort || noLetter || noNumber || noSpecial) {
          showMsg(pwMsg, 'Password must be at least 8 characters and include a letter, a number, and a special character.', true);
        } else {
          showMsg(pwMsg, '', false);
        }
        if (confirmInput.value.length > 0) {
          confirmInput.dispatchEvent(new Event('input'));
        }
      });

      confirmInput.addEventListener('input', function () {
        if (this.value.length === 0) { showMsg(confirmMsg, '', false); return; }
        if (this.value !== pwInput.value) {
          showMsg(confirmMsg, 'Passwords do not match.', true);
        } else {
          showMsg(confirmMsg, 'Passwords match.', false);
        }
      });
    }

    // ── Location input — clear hidden fields when user retypes ─────────────────
    var locInput = document.getElementById('registerLocationInput');
    var locErrDiv = document.getElementById('registerLocationError');
    var nameHidden = document.getElementById('locationNameInput');
    var latHidden = document.getElementById('homeLatitudeInput');
    var lngHidden = document.getElementById('homeLongitudeInput');

    if (locInput) {
      locInput.addEventListener('input', function () {
        if (nameHidden) nameHidden.value = '';
        if (latHidden) latHidden.value = '';
        if (lngHidden) lngHidden.value = '';
        if (locErrDiv) {
          locErrDiv.textContent = 'Click Search to validate location.';
          locErrDiv.style.color = '#6c757d';
          locErrDiv.style.display = 'block';
        }
      });
    }

    // ── File input validation on submit ────────────────────────────────────────
    var form = document.querySelector('form');
    if (!form) return;

    var verificationInput = document.querySelector('input[name="verificationDoc"]');
    var profileImgInput = document.querySelector('input[name="profileImage"]');

    var verificationMsg = verificationInput ? injectMsg(verificationInput, 'verificationFeedback') : null;
    var profileImgMsg = profileImgInput ? injectMsg(profileImgInput, 'profileImgFeedback') : null;

    form.addEventListener('submit', function (e) {
      var adminRadio = document.getElementById('admin');
      var orgRadio = document.getElementById('org');
      var blocked = false;

      // Verification doc required for org and communityAdmin
      if ((orgRadio && orgRadio.checked) || (adminRadio && adminRadio.checked)) {
        if (verificationInput && (!verificationInput.files || verificationInput.files.length === 0)) {
          showMsg(verificationMsg, 'Verification document is required.', true);
          blocked = true;
        } else {
          showMsg(verificationMsg, '', false);
        }
      }

      // Profile image required for communityAdmin
      if (adminRadio && adminRadio.checked) {
        if (profileImgInput && (!profileImgInput.files || profileImgInput.files.length === 0)) {
          showMsg(profileImgMsg, 'Profile image is required.', true);
          blocked = true;
        } else {
          showMsg(profileImgMsg, '', false);
        }
      }

      if (blocked) e.preventDefault();
    });
  })();
</script>