<h2>Posts</h2>

<% if (posts.length === 0) { %>
  <p>No posts yet.</p>
<% } %>

<% posts.forEach(post => { %>
  <div class="card mb-4 border-1 shadow-sm rounded-3">
    <div class="card-body p-4">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h5 class="fw-bold mb-0">
          <a href="/posts/<%= post._id %>" class="text-decoration-none" style="color: #04888D;">
            <%= post.title %>
          </a>
        </h5>
        <small class="text-muted fw-light">
          <%= post.createdAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
        </small>
      </div>

      <!-- Description -->
      <p class="text-secondary mb-3" style="line-height: 1.6; font-size: 0.95rem;">
        <%= post.description %>
      </p>

      <!-- Tags -->
      <div class="mb-4">
        <% post.tags.forEach(tag => { %>
          <span class="me-3 fw-medium" style="color: #1f2f9a; font-size: 0.9rem;">
            #<%= tag %>
          </span>
        <% }) %>
      </div>

      <!-- Footer -->
      <div class="d-flex justify-content-between align-items-center pt-3 border-top">

        <div class="text-muted small d-flex align-items-center">
          <span class="me-3"><i class="bi bi-heart text-danger me-1"></i> 48</span>
          <span class="me-3">
            <a href="/posts/<%= post._id %>" class="text-decoration-none text-muted">
              <i class="bi bi-chat-dots me-1"></i> <%= post.commentCount %>
            </a>
          </span>
          <span><i class="bi bi-eye me-1"></i> 18</span>
        </div>

        <div class="small">
          <span class="text-muted">Posted by</span>
          <span class="fw-bold text-danger ms-1">
            <%= post.author ? (post.author.organizationName || post.author.fullName) : "Unknown" %>
          </span>
        </div>

      </div>

    </div>
  </div>
<% }) %>