<div class="container d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm border-info" style="max-width:450px; width:100%; border-radius:15px;">
        <div class="card-body p-5 text-center">

            <div class="mb-4">
                <h2 class="d-inline-block px-4 py-2 border rounded-pill text-warning"
                    style="font-family:serif; font-size:1.5rem;">Local Connect</h2>
                <p class="text-muted small mt-2">Enter your new password below.</p>
            </div>

            <h4 class="fw-bold mb-4">Reset Password</h4>

            <form action="/reset-password/<%= token %>" method="POST">
                <div class="mb-3 text-start">
                    <label for="password" class="form-label fw-bold small">New Password :</label>
                    <input type="password" id="password" name="password" class="form-control py-2 shadow-sm"
                        placeholder="At least 6 characters" required>
                    <div id="pwMsg" class="form-text" style="display:none;"></div>
                </div>

                <div class="mb-4 text-start">
                    <label for="confirmPassword" class="form-label fw-bold small">Confirm Password :</label>
                    <input type="password" id="confirmPassword" name="confirmPassword"
                        class="form-control py-2 shadow-sm" placeholder="Re-enter password" required>
                    <div id="confirmMsg" class="form-text" style="display:none;"></div>
                </div>

                <button type="submit" class="btn w-100 py-2 text-white fw-bold shadow-sm mb-3"
                    style="background-color:#008080; border-radius:8px;">
                    Reset Password
                </button>
            </form>

        </div>
    </div>
</div>

<script>
    (function () {
        var pw = document.getElementById('password');
        var confirm = document.getElementById('confirmPassword');
        var pwMsg = document.getElementById('pwMsg');
        var confirmMsg = document.getElementById('confirmMsg');

        pw.addEventListener('input', function () {
            if (pw.value.length > 0 && pw.value.length < 6) {
                pwMsg.textContent = 'Password must be at least 6 characters.';
                pwMsg.style.color = '#dc3545';
                pwMsg.style.display = 'block';
            } else {
                pwMsg.style.display = 'none';
            }
            if (confirm.value.length > 0) confirm.dispatchEvent(new Event('input'));
        });

        confirm.addEventListener('input', function () {
            if (confirm.value.length === 0) { confirmMsg.style.display = 'none'; return; }
            if (confirm.value !== pw.value) {
                confirmMsg.textContent = 'Passwords do not match.';
                confirmMsg.style.color = '#dc3545';
            } else {
                confirmMsg.textContent = 'Passwords match.';
                confirmMsg.style.color = '#198754';
            }
            confirmMsg.style.display = 'block';
        });
    })();
</script>