<div class="container d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm border-info" style="max-width:450px; width:100%; border-radius:15px;">
        <div class="card-body p-5 text-center">

            <div class="mb-4">
                <h2 class="d-inline-block px-4 py-2 border rounded-pill text-warning"
                    style="font-family:serif; font-size:1.5rem;">Local Connect</h2>
                <p class="text-muted small mt-2">Enter your email to receive a password reset link.</p>
            </div>

            <h4 class="fw-bold mb-4">Forgot Password</h4>

            <form action="/forgot-password" method="POST">
                <div class="mb-4 text-start">
                    <label for="email" class="form-label fw-bold small">Email Address :</label>
                    <input type="email" id="email" name="email" class="form-control py-2 shadow-sm"
                        placeholder="your@gmail.com" required>
                </div>

                <button type="submit" class="btn w-100 py-2 text-white fw-bold shadow-sm mb-3"
                    style="background-color:#008080; border-radius:8px;">
                    Send Reset Link
                </button>

                <p class="small text-muted">
                    <a href="/login" class="text-secondary text-decoration-none">← Back to login</a>
                </p>
            </form>

        </div>
    </div>
</div>