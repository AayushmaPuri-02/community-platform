<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>


<% if (typeof hideSidebar !== "undefined" && hideSidebar) { %>
  <%- body %>
<% }else { %>

<div class="container-fluid">
  <!-- TOP BAR -->
<div class="row bg-light p-3 border-bottom"
     style="position: fixed; width: 100%; z-index: 1000;">
    <div class="col">
      <h4 style="color: rgb(255, 174, 24);"><b>Local Connect</b></h4>
    </div>

    <div class="col text-end">
      <% if (!userId) { %>
        <a href="/login" class="btn btn-outline-dark me-2">Login</a>
        <a href="/register" class="btn btn-dark">Register</a>
      <% } else { %>

        <% if (role === "organization" || role === "communityAdmin") { %>
          <a href="/posts/create" class="btn btn-primary me-2">Create Post</a>
        <% } %>

        <span class="me-3">Welcome, <%= organizationName || fullName %></span>
        <a href="/logout" class="btn btn-outline-danger">Logout</a>
      <% } %>
    </div>
  </div>

  <div class="row">
    <!-- SIDEBAR -->
<div class="col-2 border-end p-3"
     style="position: fixed; top: 80px; left: 0; height: calc(100vh - 80px); overflow-y: auto; background: white; z-index: 999;">
      <div class="d-grid gap-3">
        <a href="/" class="btn btn-light text-start custom-border py-3 px-4">
          <i class="bi bi-house me-2"></i> Home
        </a>

        <a href="/explore" class="btn btn-light text-start custom-border py-3 px-4">
          <i class="bi bi-compass me-2"></i> Explore
        </a>

        <a href="#" class="btn btn-light text-start custom-border py-3 px-4">
          <i class="bi bi-bookmark me-2"></i> Saved
        </a>

        <a href="/following" class="btn btn-light text-start custom-border py-3 px-4">
          <i class="bi bi-people me-2"></i> Following
        </a>

        <a href="#" class="btn btn-light text-start custom-border py-3 px-4">
          <i class="bi bi-exclamation-triangle me-2"></i> Alerts
        </a>

        <% if (userId) { %>
          <a href="/users/<%= userId %>" class="btn btn-light text-start custom-border py-3 px-4">
            <i class="bi bi-person-circle me-2"></i> Profile
          </a>
        <% } %>

        <% if (role === "systemAdmin") { %>
          <a href="/admin" class="btn btn-light text-start custom-border py-3 px-4">
            <i class="bi bi-shield-lock me-2"></i> Admin
          </a>
        <% } %>
      </div>
    </div>

    <!-- PAGE CONTENT -->
   <div class="p-4" style="margin-left: 16.66%; margin-top: 80px;">
  <%- body %>
</div>
  </div>
</div>
<% } %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>