<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background-color: #f8f9fb;
  }

  .flash-wrapper {
    position: fixed;
    top: 90px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2000;
    width: min(700px, 90%);
  }

  .admin-shell {
    width: 100%;
    margin: 0;
    padding: 0 16px 24px;
  }

  .admin-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1100;
    display: grid;
    grid-template-columns: 240px 1fr;
    align-items: center;
    column-gap: 24px;
    padding: 18px 16px 16px;
    border-bottom: 1px solid #2e2e2e;
    background: #f8f9fb;
  }

  .admin-brand {
    color: #ff8a00;
    font-weight: 800;
    font-size: 2rem;
    margin: 0;
  }

  .admin-page-title {
    margin: 0;
    text-align: center;
    font-size: 2.1rem;
    font-weight: 700;
    color: #222;
  }

.admin-layout {
  margin-top: 18px;
}
  .admin-sidebar {
    position: fixed;
    top: 110px;
    left: 16px;
    width: 240px;
    height: calc(100vh - 126px);
    overflow-y: auto;
    padding-right: 14px;
    border-right: 1px solid #2e2e2e;
    background: #f8f9fb;
  }

  .admin-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid #efc991;
    border-radius: 14px;
    text-decoration: none;
    color: #222;
    margin-bottom: 12px;
    background: #fff;
    transition: 0.2s ease;
  }

  .admin-link:hover,
  .admin-link.active {
    background: #fdf6ee;
    border-color: #e8a34d;
    color: #111;
  }

.admin-content {
  margin-left: 264px;
  padding: 25px 16px 0 0;
}

  .stat-card {
    background: #f8efe3;
    border-radius: 18px;
    padding: 22px;
    text-align: center;
    box-shadow: 0 6px 14px rgba(0,0,0,0.06);
  }

  .stat-label {
    font-size: 1rem;
    color: #444;
    margin-bottom: 8px;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: #222;
  }

  .status-chip {
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 999px;
    font-weight: 600;
    margin-right: 10px;
    margin-bottom: 10px;
  }

  .chip-approved { background: #dff5e8; color: #137a42; }
  .chip-pending { background: #fff3cd; color: #8a6d00; }
  .chip-rejected { background: #fde2e2; color: #b42318; }

  .activity-card,
  .request-card,
  .directory-card,
  .detail-card {
    border: 1px solid #e8e8e8;
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 12px;
    background: #fff;
  }

  .filter-chip {
    display: inline-block;
    padding: 10px 16px;
    border: 1px solid #ddd;
    border-radius: 12px;
    text-decoration: none;
    color: #333;
    margin-right: 10px;
    margin-bottom: 12px;
    background: #fff;
  }

  .filter-chip.active {
    background: #f6f0e7;
    border-color: #e7b16a;
    color: #111;
  }

  .detail-label {
    font-size: 0.85rem;
    color: #6c757d;
    display: block;
    margin-bottom: 4px;
  }

  .detail-row {
    margin-bottom: 14px;
  }

  @media (max-width: 992px) {
    .admin-header {
      position: static;
      grid-template-columns: 1fr;
      padding: 18px 16px 14px;
    }

    .admin-page-title {
      text-align: left;
      margin-top: 8px;
    }

    .flash-wrapper {
      top: 14px;
    }

    .admin-layout {
      grid-template-columns: 1fr;
      margin-top: 18px;
    }

    .admin-sidebar {
      position: static;
      width: 100%;
      height: auto;
      border-right: none;
      padding-right: 0;
      overflow: visible;
    }

    .admin-content {
      margin-left: 0;
    }
  }
</style>






</head>
<body>

  <div class="flash-wrapper">
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (info && info.length > 0) { %>
      <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <%= info[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
  </div>

  <div class="admin-shell">
    <div class="admin-header">
      <h1 class="admin-brand">Local Connect</h1>
      <h2 class="admin-page-title"><%= title %></h2>
    </div>

    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a href="/admin" class="admin-link <%= activeAdminTab === 'dashboard' ? 'active' : '' %>">
          <i class="bi bi-house-door"></i>
          <span>Dashboard</span>
        </a>

        <a href="/admin/requests" class="admin-link <%= activeAdminTab === 'requests' ? 'active' : '' %>">
          <i class="bi bi-patch-check"></i>
          <span>Verification Requests</span>
        </a>

        <a href="/admin/directory" class="admin-link <%= activeAdminTab === 'directory' ? 'active' : '' %>">
          <i class="bi bi-folder2-open"></i>
          <span>Directory</span>
        </a>

        <a href="#" class="admin-link">
          <i class="bi bi-gear"></i>
          <span>Settings</span>
        </a>

        <a href="/logout" class="admin-link">
          <i class="bi bi-box-arrow-right"></i>
          <span>Logout</span>
        </a>
      </aside>

      <main class="admin-content">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(el => {
        el.classList.remove('show');
      });
    }, 3000);
  </script>
</body>
</html>