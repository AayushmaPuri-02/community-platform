<style>
    .card-profile {
        border-radius: 18px;
        border: none;
    }

    .post-link {
        color: #04888D;
        text-decoration: none;
        font-weight: 600;
    }

    .post-link:hover {
        text-decoration: underline;
    }

    .badge-tag {
        background-color: #e0f2f1;
        color: #04888D;
        font-weight: 500;
    }

    .hero-banner {
        height: 220px;
        border-radius: 18px 18px 0 0;
        background-image: linear-gradient(rgba(223, 244, 242, 0.72), rgba(243, 253, 252, 0.72)), url("<%= user.profileImage || '/images/default-avatar.png' %>");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .profile-avatar {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border: 4px solid white;
        margin-top: -65px;
        background: white;
    }

    .info-label {
        font-size: 0.8rem;
        color: #6c757d;
        display: block;
        margin-bottom: 4px;
    }
</style>

<div class="container py-4">

    <p>
        <a href="<%= backUrl %>" class="btn btn-outline-secondary btn-sm">← Back to Reports</a>
    </p>

    <%- include('../partials/adminSuspensionControls', {
        targetUser: user,
        returnTo: '/admin/reports/user/' + user._id + '?from=' + encodeURIComponent(backUrl)
    }) %>

    <% if (accountReports && accountReports.length > 0) { %>
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                <h6 class="fw-bold mb-0 text-danger"><i class="bi bi-flag me-2"></i>Account Reports (<%= accountReports.length %>)</h6>
                <% if (!anyReviewed) { %>
                    <button type="button" class="btn btn-sm btn-warning rounded-pill px-3"
                        data-bs-toggle="modal" data-bs-target="#accountWarnModal"
                        style="font-size:12px;">
                        <i class="bi bi-envelope-exclamation me-1"></i>Send Warning
                    </button>
                <% } else { %>
                    <span class="badge bg-success rounded-pill px-2" style="font-size:0.75rem;">Warning sent</span>
                <% } %>
            </div>
            <% accountReports.forEach(function(report) { %>
                <div class="border rounded-3 p-3 mb-2" style="font-size:13px;">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="report-reason-text"><%= getReasonLabel(report.reason) %></span>
                            <span class="text-muted small ms-2">
                                <%= report.createdAt.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
                            </span>
                        </div>
                        <% if (report.status !== 'reviewed' && !report.warningSent) { %>
                            <form action="/admin/reports/<%= report._id %>/dismiss" method="POST" class="m-0">
                                <input type="hidden" name="returnTo" value="/admin/reports/user/<%= user._id %>?from=/admin/reports">
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2" style="font-size:11px;">Dismiss</button>
                            </form>
                        <% } %>
                    </div>
                    <div class="text-muted small mt-1">
                        Reported by <%= report.reportedBy ? (report.reportedBy.communityName || report.reportedBy.organizationName || report.reportedBy.fullName) : 'Unknown' %>
                    </div>
                    <% if (report.note) { %>
                        <div class="mt-2 p-2 bg-light rounded-2 small"><%= report.note %></div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } %>

    <% if (user.warningHistory && user.warningHistory.length> 0) { %>
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
            <h6 class="fw-bold mb-3 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Warning History (<%=
                    user.warningHistory.length %>)</h6>
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="font-size:13px;">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Reason</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% user.warningHistory.slice().reverse().forEach(function(w) { %>
                            <tr>
                                <td class="align-middle text-muted" style="white-space:nowrap;">
                                    <%= new Date(w.warnedAt).toLocaleDateString('en-GB', { day:'numeric', month:'short',
                                        year:'numeric' }) %>
                                </td>
                                <td class="align-middle">
                                    <span class="report-reason-text"><%= getReasonLabel(w.reason) %></span>
                                </td>
                                <td class="align-middle text-muted" style="font-size:12.5px;">
                                    <%= w.note || '—' %>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

            <% if (user.role==='citizen' ) { %>
                <!-- ===================== CITIZEN PROFILE ===================== -->
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card card-profile shadow-sm overflow-hidden">
                            <div class="hero-banner"></div>

                            <div class="card-body text-center px-4 pb-5">
                                <img src="<%= user.profileImage || '/images/default-avatar.png' %>" alt="Profile Image"
                                    class="rounded-circle shadow-sm profile-avatar">

                                <h2 class="fw-bold mt-3 mb-1 d-inline-flex align-items-center justify-content-center flex-wrap gap-1">
                                    <span><%= user.fullName %></span>
                                    <%- include('../partials/volunteerBadge', { user: user }) %>
                                </h2>

                                <p class="text-muted mb-2">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    <%= user.location || 'No location added' %>
                                </p>

                                <p class="text-muted small mb-2">
                                    Joined <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %>
                                </p>

                                <p class="text-muted small mb-1">
                                    Following <strong>
                                        <%= followingCount %>
                                    </strong>
                                    organization/community account<%= followingCount===1 ? '' : 's' %>
                                </p>

                                <% if (user.volunteerCount && user.volunteerCount> 0) { %>
                                    <p class="text-muted small mb-4">
                                        Volunteered <strong>
                                            <%= user.volunteerCount %>
                                        </strong>
                                        time<%= user.volunteerCount===1 ? '' : 's' %>
                                    </p>
                                    <% } else { %>
                                        <p class="mb-4"></p>
                                        <% } %>

                            </div>
                        </div>
                    </div>
                </div>

                <% } else { %>
                    <!-- ===================== ORG / COMMUNITY ADMIN PROFILE ===================== -->
                    <div class="row g-4">

                        <!-- CENTER CONTENT -->
                        <div class="col-md-9 col-lg-8">
                            <div class="card card-profile shadow-sm overflow-hidden mb-4">
                                <div class="hero-banner"></div>

                                <div class="card-body text-center px-4 pb-5">
                                    <img src="<%= user.profileImage || '/images/default-avatar.png' %>"
                                        alt="Profile Image" class="rounded-circle shadow-sm profile-avatar">

                                    <h2 class="fw-bold mt-3 mb-1">
                                        <% if (user.role==='communityAdmin' ) { %>
                                            <%= user.communityName || (user.location + ' Locals' ) %>
                                                <% } else { %>
                                                    <%= user.organizationName || user.fullName %>
                                                        <% } %>
                                    </h2>

                                    <p class="text-muted mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        <%= user.location || 'No location added' %>
                                    </p>
                                </div>
                            </div>

                            <h5 class="fw-bold mb-3">Posts</h5>

                            <% if (posts.length===0) { %>
                                <div class="p-5 text-center bg-white rounded-4 border-0 shadow-sm">
                                    <p class="text-muted mb-0">Nothing posted yet.</p>
                                </div>
                                <% } %>

                                    <% posts.forEach(function(post) { %>
                                        <div class="card card-profile shadow-sm mb-3 border-0">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start gap-3">
                                                    <a href="/admin/reports/post/<%= post._id %>"
                                                        class="post-link fs-5">
                                                        <%= post.title %>
                                                    </a>
                                                    <small class="text-muted">
                                                        <%= post.type === 'alert' ? formatAlertDate(post.createdAt) : post.createdAt.toLocaleDateString() %>
                                                    </small>
                                                </div>

                                                <p class="mt-2 text-secondary">
                                                    <%= post.description %>
                                                </p>

                                                <% if (post.tags && post.tags.length> 0) { %>
                                                    <div>
                                                        <% post.tags.forEach(function(tag) { %>
                                                            <span class="badge badge-tag me-1">#<%= tag %></span>
                                                            <% }); %>
                                                    </div>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% }); %>
                        </div>

                        <!-- RIGHT SIDEBAR -->
                        <div class="col-lg-4">
                            <div class="card card-profile shadow-sm border-0">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3 text-muted">
                                        <%= user.role==='communityAdmin' ? 'Community Information'
                                            : 'Organization Information' %>
                                    </h6>

                                    <div class="mb-3">
                                        <span class="info-label">About</span>
                                        <p class="small mb-0">
                                            <%= user.bio || 'No bio provided.' %>
                                        </p>
                                    </div>

                                    <div class="mb-3">
                                        <span class="info-label">Contact</span>
                                        <p class="small mb-1">
                                            <%= user.contactInfo || 'N/A' %>
                                        </p>
                                    </div>

                                    <% if (user.socialMediaLink) { %>
                                        <div class="mb-3">
                                            <span class="info-label">Website / Social</span>
                                            <a href="<%= user.socialMediaLink %>" target="_blank"
                                                class="small text-decoration-none">
                                                Visit Link
                                            </a>
                                        </div>
                                        <% } %>

                                            <hr>

                                            <div class="mb-3">
                                                <span class="info-label">Followers</span>
                                                <p class="small mb-0">
                                                    <%= followerCount %>
                                                </p>
                                            </div>

                                            <div class="mb-3">
                                                <span class="info-label">Following</span>
                                                <p class="small mb-0">
                                                    <%= followingCount %>
                                                </p>
                                            </div>

                                            <p class="text-muted small mb-0">
                                                Joined <%= user.createdAt ? new
                                                    Date(user.createdAt).toLocaleDateString() : 'N/A' %>
                                            </p>
                                </div>
                            </div>
                        </div>

                    </div>
                    <% } %>

<% if (accountReports && accountReports.length > 0 && !anyReviewed) { %>
    <div class="modal fade" id="accountWarnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-envelope-exclamation me-2 text-warning"></i>Send Warning Email
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="POST" action="/admin/reports/<%= accountReports[0]._id %>/warn">
                    <input type="hidden" name="returnTo" value="/admin/reports/user/<%= user._id %>?from=/admin/reports">
                    <div class="modal-body">
                        <p class="text-muted small mb-2">
                            Account: <strong><%= user.communityName || user.organizationName || user.fullName %></strong>
                        </p>
                        <label class="form-label fw-semibold small">Warning message <span class="text-danger">*</span></label>
                        <textarea name="message" class="form-control" rows="4" maxlength="500" required
                            placeholder="Explain the issue and what the user should do…"></textarea>
                        <div class="form-text">Max 50 words.</div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning rounded-pill px-4">Send Warning</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

</div>

<style>
    .report-reason-text {
        color: #dc3545;
        font-size: 12.5px;
        font-weight: 500;
    }
</style>