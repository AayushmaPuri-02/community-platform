<% var reasonLabels={ spam:'Spam', misinformation:'Misinformation', harassment:'Harassment', hate_speech:'Hate Speech',
    scam_fraud:'Scam / Fraud', inappropriate:'Inappropriate Content' }; %>

    <% if (reports.length===0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <p class="text-muted mb-0"><i class="bi bi-flag me-2"></i>No reports yet.</p>
        </div>
        <% } else { %>
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Post</th>
                                <th>Post Author</th>
                                <th>Reported By</th>
                                <th>Reason</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% reports.forEach(function(report) { %>
                                <tr>
                                    <td class="align-middle">
                                        <% if (report.post) { %>
                                            <% var t=report.post.title || '' ; %>
                                                <a href="/admin/reports/post/<%= report.post._id %>"
                                                    class="text-decoration-none fw-semibold" style="color:#04888D;"
                                                    title="<%= t %>">
                                                    <%= t.length> 40 ? t.slice(0, 40).trimEnd() + '…' : t %>
                                                </a>
                                                <% } else { %>
                                                    <span class="text-muted">[Post deleted]</span>
                                                    <% } %>
                                    </td>
                                    <td class="align-middle text-muted">
                                        <% if (report.post && report.post.author) { %>
                                            <%= report.post.author.organizationName || report.post.author.fullName %>
                                                <% } else { %>—<% } %>
                                    </td>
                                    <td class="align-middle text-muted">
                                        <% if (report.reportedBy) { %>
                                            <%= report.reportedBy.organizationName || report.reportedBy.fullName %>
                                                <% } else { %>—<% } %>
                                    </td>
                                    <td class="align-middle">
                                        <span
                                            class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2"
                                            style="font-size:11px;">
                                            <%= reasonLabels[report.reason] || report.reason %>
                                        </span>
                                    </td>
                                    <td class="align-middle text-muted" style="white-space:nowrap;">
                                        <%= report.createdAt.toLocaleDateString('en-GB', { day:'numeric', month:'short',
                                            year:'numeric' }) %>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>

                <% if (warnedUsers && warnedUsers.length> 0) { %>
                    <h6 class="fw-bold mt-4 mb-3" style="color:#04888D;">Warned Accounts</h6>
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" style="font-size:13px;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Role</th>
                                        <th>Warnings</th>
                                        <th>Latest Warning</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% warnedUsers.forEach(function(u) { %>
                                        <% var latest=u.warningHistory[u.warningHistory.length - 1]; %>
                                            <tr>
                                                <td class="align-middle fw-semibold">
                                                    <%= u.communityName || u.organizationName || u.fullName %>
                                                </td>
                                                <td class="align-middle text-muted text-capitalize"
                                                    style="font-size:12px;">
                                                    <%= u.role==='communityAdmin' ? 'Community Admin' : u.role %>
                                                </td>
                                                <td class="align-middle">
                                                    <span
                                                        class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2">
                                                        <%= u.warningHistory.length %>
                                                    </span>
                                                </td>
                                                <td class="align-middle text-muted" style="white-space:nowrap;">
                                                    <%= latest ? new Date(latest.warnedAt).toLocaleDateString('en-GB', {
                                                        day:'numeric', month:'short', year:'numeric' }) : '—' %>
                                                </td>
                                                <td class="align-middle">
                                                    <a href="/admin/directory/<%= u._id %>"
                                                        class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                        style="font-size:11.5px;">
                                                        View Profile
                                                    </a>
                                                </td>
                                            </tr>
                                            <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>