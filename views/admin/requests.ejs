<% var orgRequests=pendingUsers.filter(function(u) { return u.role==='organization' ; }); var
  adminRequests=pendingUsers.filter(function(u) { return u.role==='communityAdmin' ; }); %>

  <h4 class="mb-4">Pending Verification Requests</h4>

  <% if (pendingUsers.length===0) { %>
    <p class="text-muted">No pending requests.</p>
    <% } else { %>

      <div class="row g-4">

        <!-- Organizations -->
        <div class="col-lg-6">
          <h6 class="fw-semibold text-muted mb-3"
            style="text-transform:uppercase; letter-spacing:0.07em; font-size:11.5px;">
            Organizations <span class="badge rounded-pill ms-1"
              style="background:#e0f2f1; color:#04888D; font-size:10px;">
              <%= orgRequests.length %>
            </span>
          </h6>

          <% if (orgRequests.length===0) { %>
            <p class="text-muted small">No pending organization requests.</p>
            <% } %>

              <% orgRequests.forEach(function(u) { %>
                <div class="request-card">
                  <div class="fw-semibold mb-1">
                    <a href="/admin/requests/<%= u._id %>" class="text-decoration-none" style="color:#04888D;">
                      <%= u.organizationName || u.fullName %>
                    </a>
                  </div>
                  <div class="small text-muted">
                    <%= u.email %>
                  </div>
                  <div class="small text-muted mt-1">
                    Requested <%= u.createdAt.toLocaleDateString("en-GB", { day:"numeric", month:"short", year:"numeric"
                      }) %>
                  </div>
                </div>
                <% }); %>
        </div>

        <!-- Community Admins -->
        <div class="col-lg-6">
          <h6 class="fw-semibold text-muted mb-3"
            style="text-transform:uppercase; letter-spacing:0.07em; font-size:11.5px;">
            Community Admins <span class="badge rounded-pill ms-1"
              style="background:#e0f2f1; color:#04888D; font-size:10px;">
              <%= adminRequests.length %>
            </span>
          </h6>

          <% if (adminRequests.length===0) { %>
            <p class="text-muted small">No pending community admin requests.</p>
            <% } %>

              <% adminRequests.forEach(function(u) { %>
                <div class="request-card">
                  <div class="fw-semibold mb-1">
                    <a href="/admin/requests/<%= u._id %>" class="text-decoration-none" style="color:#04888D;">
                      <%= u.communityName || u.fullName %>
                    </a>
                  </div>
                  <div class="small text-muted">
                    <%= u.email %>
                  </div>
                  <div class="small text-muted mt-1">
                    Requested <%= u.createdAt.toLocaleDateString("en-GB", { day:"numeric", month:"short", year:"numeric"
                      }) %>
                  </div>
                </div>
                <% }); %>
        </div>

      </div>

      <% } %>