<h4 class="mb-4">Pending Verification Requests</h4>

<% if (pendingUsers.length === 0) { %>
  <p class="text-muted">No pending requests.</p>
<% } %>

<% pendingUsers.forEach(user => { %>
  <div class="request-card d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <div class="fw-bold mb-1"><%= user.organizationName || user.fullName %></div>
      <div class="text-muted small mb-1 text-capitalize"><%= user.role %></div>
      <div class="small text-muted">
        Requested on
        <%= user.createdAt.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "short",
          year: "numeric"
        }) %>
      </div>
    </div>

    <a href="/admin/requests/<%= user._id %>" class="btn btn-outline-primary btn-sm px-3">
      View
    </a>
  </div>
<% }) %>