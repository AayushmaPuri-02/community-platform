<style>
  .rd-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }

  .rd-section-title {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid #f1f5f9;
  }

  .rd-row {
    display: flex;
    gap: 12px;
    margin-bottom: 12px;
    align-items: baseline;
  }

  .rd-label {
    font-size: 11.5px;
    color: #94a3b8;
    font-weight: 500;
    min-width: 120px;
    flex-shrink: 0;
  }

  .rd-value {
    font-size: 13.5px;
    color: #1e293b;
    font-weight: 500;
    word-break: break-word;
  }

  .rd-divider {
    border: none;
    border-top: 1px solid #f1f5f9;
    margin: 20px 0;
  }

  .rd-doc-wrapper {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .rd-action-bar {
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 20px 28px;
  }
</style>

<div class="mb-4">
  <a href="/admin/requests" class="btn btn-outline-secondary btn-sm">← Back to Requests</a>
</div>

<div class="rd-card">

  <!-- Header -->
  <div class="px-4 pt-4 pb-3" style="border-bottom:1px solid #f1f5f9;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h5 class="fw-bold mb-0" style="font-size:15px; color:#1e293b;">Request Review</h5>
        <div class="text-muted mt-1" style="font-size:12px;">
          <% if (user.role==='communityAdmin' ) { %>
            Community Admin application
            <% } else { %>
              Organization registration
              <% } %>
                &middot; Submitted
                <%= user.createdAt.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' }) %>
        </div>
      </div>
      <span class="badge bg-warning text-dark px-3 py-2" style="font-size:11.5px;">Pending Review</span>
    </div>
  </div>

  <div class="p-4">

    <!-- SECTION 1: Applicant Information -->
    <div class="mb-4">
      <div class="rd-section-title">Applicant Information</div>

      <div class="rd-row">
        <span class="rd-label">Name</span>
        <span class="rd-value">
          <% if (user.role==='communityAdmin' ) { %>
            <%= user.communityName || (user.location + ' Locals' ) %>
              <span class="text-muted fw-normal" style="font-size:12px; margin-left:6px;">(Full name: <%= user.fullName
                  %>)</span>
              <% } else { %>
                <%= user.organizationName || user.fullName %>
                  <% } %>
        </span>
      </div>

      <div class="rd-row">
        <span class="rd-label">Email</span>
        <span class="rd-value">
          <%= user.email %>
        </span>
      </div>

      <div class="rd-row">
        <span class="rd-label">Role</span>
        <span class="rd-value text-capitalize">
          <%= user.role==='communityAdmin' ? 'Community Admin' : user.role %>
        </span>
      </div>

      <div class="rd-row">
        <span class="rd-label">Location</span>
        <span class="rd-value">
          <%= user.location || 'N/A' %>
        </span>
      </div>

      <% if (user.mobileNumber) { %>
        <div class="rd-row">
          <span class="rd-label">Mobile</span>
          <span class="rd-value">
            <%= user.mobileNumber %>
          </span>
        </div>
        <% } %>

          <% if (user.socialMediaLink) { %>
            <div class="rd-row">
              <span class="rd-label">Website / Social</span>
              <a href="<%= user.socialMediaLink %>" target="_blank" class="rd-value text-decoration-none"
                style="color:#2563eb;">
                <%= user.socialMediaLink %>
              </a>
            </div>
            <% } %>
    </div>

    <hr class="rd-divider">

    <!-- SECTION 2: Submitted Documents -->
    <div class="mb-4">
      <div class="rd-section-title">Verification Document</div>

      <% if (user.verificationDoc) { %>
        <% var docUrl=user.verificationDoc.toLowerCase(); %>
          <% var isPdf=docUrl.includes('.pdf') || docUrl.includes('/raw/upload/'); %>
            <div class="rd-doc-wrapper">
              <% if (isPdf) { %>
                <iframe src="<%= user.verificationDoc %>#toolbar=0&navpanes=0&scrollbar=0"
                  style="width:100%; height:580px; border:none; display:block;">
                </iframe>
                <% } else { %>
                  <img src="<%= user.verificationDoc %>" alt="Verification Document"
                    style="width:100%; max-height:480px; object-fit:contain; display:block; background:#f8fafc; padding:12px;">
                  <% } %>
            </div>
            <a href="<%= user.verificationDoc %>" target="_blank" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-box-arrow-up-right me-1"></i>Open in New Tab
            </a>
            <% } else { %>
              <p class="text-muted mb-0" style="font-size:13.5px;">No verification document uploaded.</p>
              <% } %>
    </div>

    <% if (user.role==='communityAdmin' && user.profileImage) { %>
      <hr class="rd-divider">
      <div class="mb-4">
        <div class="rd-section-title">Profile Photo</div>
        <img src="<%= user.profileImage %>" alt="Profile Photo" class="rounded-3"
          style="width:120px; height:120px; object-fit:cover; border:1px solid #e2e8f0;">
      </div>
      <% } %>

  </div><!-- /p-4 -->

  <!-- ACTION BAR -->
  <div class="rd-action-bar">
    <div class="rd-section-title mb-3">Decision</div>
    <div class="d-flex flex-wrap gap-3 align-items-start">

      <form action="/admin/requests/<%= user._id %>/approve" method="POST" class="m-0">
        <button type="submit" class="btn btn-success px-5 fw-semibold">
          <i class="bi bi-check-circle me-2"></i>Approve
        </button>
      </form>

      <form action="/admin/requests/<%= user._id %>/reject" method="POST" class="m-0">
        <div class="d-flex flex-wrap gap-2 align-items-start">
          <div>
            <input type="text" name="rejectionReason" class="form-control" placeholder="Reason for rejection (required)"
              style="min-width:300px; font-size:13.5px;" required>
            <div class="form-text" style="font-size:11.5px;">
              Provide a clear reason — this will be sent to the applicant.
            </div>
          </div>
          <button type="submit" class="btn btn-danger px-4 fw-semibold">
            <i class="bi bi-x-circle me-2"></i>Reject
          </button>
        </div>
      </form>

    </div>
  </div>

</div><!-- /rd-card -->