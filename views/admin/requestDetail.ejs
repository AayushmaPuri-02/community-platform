<p>
  <a href="/admin/requests" class="btn btn-outline-secondary btn-sm">← Back to Requests</a>
</p>

<h2>Request Detail</h2>

<div style="border:1px solid black; padding:15px;">

  <p><strong>Name:</strong> <%= user.organizationName || user.fullName %></p>

  <p><strong>Email:</strong> <%= user.email %></p>

  <p><strong>Role:</strong> <%= user.role %></p>

  <p><strong>Location:</strong> <%= user.location %></p>

  <% if (user.mobileNumber) { %>
    <p><strong>Mobile:</strong> <%= user.mobileNumber %></p>
  <% } %>

  <% if (user.socialMediaLink) { %>
    <p><strong>Social:</strong> <%= user.socialMediaLink %></p>
  <% } %>

  <p><strong>Requested At:</strong> <%= user.createdAt.toLocaleString() %></p>

  <hr>

<p><strong>Verification Document:</strong></p>

<% if (user.verificationDoc) { %>
  <h5>Verification Document</h5>

  <div style="border:1px solid #ccc; border-radius:8px; overflow:hidden; max-width:900px; background:#fff;">
    
    <% if (user.verificationDoc.includes(".pdf")) { %>
      <iframe 
        src="<%= user.verificationDoc %>#toolbar=0&navpanes=0&scrollbar=0&view=FitH"
        style="width:100%; height:600px; border:none;">
      </iframe>
    <% } else { %>
      <img 
        src="<%= user.verificationDoc %>" 
        alt="Verification Document"
        class="img-fluid"
        style="width:100%; max-height:500px; object-fit: contain; display:block;">
    <% } %>

  </div>

  <br>

  <a href="<%= user.verificationDoc %>" target="_blank">
    Open in new tab
  </a>
<% } %>

  <hr>

<form action="/admin/requests/<%= user._id %>/approve" method="POST" style="display:inline;">
  <button type="submit">Approve</button>
</form>

<form action="/admin/requests/<%= user._id %>/reject" method="POST" style="display:inline; margin-left:10px;">
  <input type="text" name="rejectionReason" placeholder="Reason for rejection" required>
  <button type="submit">Reject</button>
</form>

</div>