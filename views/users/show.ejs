<style>
  body { background-color: #f4f7f6; }

  .card-profile {
    border-radius: 18px;
    border: none;
  }

  .post-link {
    color: #04888D;
    text-decoration: none;
    font-weight: 600;
  }

  .post-link:hover {
    text-decoration: underline;
  }

  .badge-tag {
    background-color: #e0f2f1;
    color: #04888D;
    font-weight: 500;
  }

.hero-banner {
  height: 220px;
  border-radius: 18px 18px 0 0;
  background-image: linear-gradient(rgba(223, 244, 242, 0.72), rgba(243, 253, 252, 0.72)), url("<%= user.profileImage || '/images/default-avatar.png' %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

  .profile-avatar {
    width: 130px;
    height: 130px;
    object-fit: cover;
    border: 4px solid white;
    margin-top: -65px;
    background: white;
  }

  .info-label {
    font-size: 0.8rem;
    color: #6c757d;
    display: block;
    margin-bottom: 4px;
  }
</style>

<div class="container py-4">
  <% if (backUrl) { %>
    <p>
      <a href="<%= backUrl %>" class="btn btn-outline-secondary btn-sm">← Back</a>
    </p>
  <% } %>

  <% if (user.role === "citizen") { %>
    <!-- CITIZEN PROFILE -->
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card card-profile shadow-sm overflow-hidden">
          <div class="hero-banner"></div>

          <div class="card-body text-center px-4 pb-5">
            <img
              src="<%= user.profileImage || '/images/default-avatar.png' %>"
              alt="Profile Image"
              class="rounded-circle shadow-sm profile-avatar"
            >

            <h2 class="fw-bold mt-3 mb-1"><%= user.fullName %></h2>

            <p class="text-muted mb-2">
              <i class="bi bi-geo-alt me-1"></i>
              <%= user.location || 'No location added' %>
            </p>

            <p class="text-muted small mb-2">
  Joined <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : "N/A" %>
</p>

<p class="text-muted small mb-4">
  Following <strong><%= followingCount %></strong> organization/community account<%= followingCount === 1 ? '' : 's' %>
</p>

            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <% if (userId && userId.toString() === user._id.toString()) { %>
                <a href="/profile/edit" class="btn btn-outline-secondary btn-sm px-4">Edit Profile</a>
              <% } %>

              <% if (userId && userId.toString() !== user._id.toString() && role !== "systemAdmin") { %>
                <a href="/messages/<%= user._id %>" class="btn btn-primary btn-sm px-4">Message</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% } else { %>
    <!-- ORGANIZATION / COMMUNITY PROFILE -->
    <div class="row g-4">
      <!-- CENTER CONTENT -->
      <div class="col-md-9 col-lg-8">
        <div class="card card-profile shadow-sm overflow-hidden mb-4">
          <div class="hero-banner"></div>

          <div class="card-body text-center px-4 pb-5">
            <img
              src="<%= user.profileImage || '/images/default-avatar.png' %>"
              alt="Profile Image"
              class="rounded-circle shadow-sm profile-avatar"
            >

            <h2 class="fw-bold mt-3 mb-1"><%= user.organizationName || user.fullName %></h2>

            <p class="text-muted mb-2">
  <i class="bi bi-geo-alt me-1"></i>
  <%= user.location || 'No location added' %>
</p>



            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <% if (userId && userId.toString() === user._id.toString()) { %>
    <a href="/profile/edit" class="btn btn-primary px-4 shadow-sm">
      <i class="bi bi-pencil me-1"></i> Edit Profile
    </a>
  <% } %>

              <% if (
                userId &&
                userId.toString() !== user._id.toString() &&
                role !== "systemAdmin" &&
                (user.role === "organization" || user.role === "communityAdmin")
              ) { %>
<form action="/follow/<%= user._id %>/toggle" method="POST" class="d-inline">
  <button class="btn btn-sm px-4 <%= isFollowing ? 'btn-primary' : 'btn-outline-primary' %>">
    <%= isFollowing ? "Following" : "Follow" %>
  </button>
</form>
              <% } %>

                <% if (userId && userId.toString() !== user._id.toString() && role !== "systemAdmin") { %>
    <a href="/messages/<%= user._id %>" class="btn btn-outline-primary px-4">
      Message
    </a>
  <% } %>
            </div>
          </div>
        </div>

        <h5 class="fw-bold mb-3">Posts</h5>

        <% if (posts.length === 0) { %>
          <div class="p-5 text-center bg-white rounded-4 border-0 shadow-sm">
            <p class="text-muted mb-0">Nothing posted yet.</p>
          </div>
        <% } %>

        <% posts.forEach(post => { %>
          <div class="card card-profile shadow-sm mb-3 border-0">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <a href="/posts/<%= post._id %>" class="post-link fs-5"><%= post.title %></a>
                <small class="text-muted"><%= post.createdAt.toLocaleDateString() %></small>
              </div>

              <p class="mt-2 text-secondary"><%= post.description %></p>

              <% if (post.tags && post.tags.length > 0) { %>
                <div>
                  <% post.tags.forEach(tag => { %>
                    <span class="badge badge-tag me-1">#<%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- RIGHT SIDEBAR -->
      <div class="col-lg-4">
        <div class="card card-profile shadow-sm border-0">
          <div class="card-body">
            <h6 class="fw-bold mb-3 text-muted">Organization Information</h6>

            <div class="mb-3">
              <span class="info-label">About</span>
              <p class="small mb-0"><%= user.bio || 'No bio provided.' %></p>
            </div>

            <div class="mb-3">
              <span class="info-label">Contact</span>
              <p class="small mb-1"><%= user.contactInfo || 'N/A' %></p>
            </div>

            <% if (user.socialMediaLink) { %>
              <div class="mb-3">
                <span class="info-label">Website / Social</span>
                <a href="<%= user.socialMediaLink %>" target="_blank" class="small text-decoration-none">
                  Visit Link
                </a>
              </div>
            <% } %>

            <hr>

<div class="mb-3">
  <span class="info-label">Followers</span>
  <p class="small mb-0"><%= followerCount %></p>
</div>

<div class="mb-3">
  <span class="info-label">Following</span>
  <p class="small mb-0"><%= followingCount %></p>
</div>

<p class="text-muted small mb-0">
  Joined <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : "N/A" %>
</p>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>