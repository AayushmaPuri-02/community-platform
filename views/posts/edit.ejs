<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="mb-3">
        <a href="/posts/<%= post._id %>" class="btn btn-outline-secondary btn-sm">
          ← Back to Post
        </a>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 mb-4">Edit Post</h1>

          <form action="/posts/<%= post._id %>/edit" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="title" class="form-label fw-semibold">Title</label>
            <input
  type="text"
  id="title"
  name="title"
  class="form-control"
  value="<%= post.title %>"
  required
>
<div class="invalid-feedback">
  Title must not exceed 30 words.
</div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label fw-semibold">Description</label>
            <textarea
  id="description"
  name="description"
  class="form-control"
  rows="5"
  required
><%= post.description %></textarea>

<div class="invalid-feedback">
  Description must not exceed 200 words.
</div>
            </div>

            <div class="mb-3">
              <label for="type" class="form-label fw-semibold">Type</label>
              <select id="type" name="type" class="form-select" required>
                <option value="event" <%= post.type === "event" ? "selected" : "" %>>Event</option>
                <option value="volunteer" <%= post.type === "volunteer" ? "selected" : "" %>>Volunteer</option>
                <option value="alert" <%= post.type === "alert" ? "selected" : "" %>>Alert</option>
                <option value="training" <%= post.type === "training" ? "selected" : "" %>>Training</option>
                <option value="communityUpdate" <%= post.type === "communityUpdate" ? "selected" : "" %>>Community Update</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="tags" class="form-label fw-semibold">Tags (comma separated)</label>
              <input
                type="text"
                id="tags"
                name="tags"
                class="form-control"
                value="<%= post.tags && post.tags.length ? post.tags.join(", ") : "" %>"
              >
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Current Images</label>

              <% if (post.images && post.images.length > 0) { %>
                <div class="row g-3 mb-3">
                  <% post.images.forEach(image => { %>
                    <div class="col-6 col-md-4">
                      <img
                        src="<%= image.url %>"
                        alt="Post image"
                        class="img-fluid rounded border"
                        style="height: 180px; width: 100%; object-fit: cover;"
                      >
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="text-muted mb-3">No images uploaded for this post.</p>
              <% } %>

              <label for="postImages" class="form-label fw-semibold">Upload New Images</label>
              <input
                type="file"
                id="postImages"
                name="postImages"
                class="form-control"
                accept="image/*"
                multiple
              >
<div class="form-text text-danger">
  If you upload new images, all existing images will be replaced. Allowed formats: JPG, JPEG, PNG. Maximum size: 1.5 MB per image. You can upload up to 4 images.
</div>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary">Update Post</button>
              <a href="/posts/<%= post._id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function wordCount(text) {
    return text.trim().split(/\s+/).filter(Boolean).length;
  }

  const titleInput = document.getElementById("title");
  const descInput = document.getElementById("description");

  titleInput.addEventListener("input", () => {
    const count = wordCount(titleInput.value);

    if (count > 30) {
      titleInput.classList.add("is-invalid");
    } else {
      titleInput.classList.remove("is-invalid");
    }
  });

  descInput.addEventListener("input", () => {
    const count = wordCount(descInput.value);

    if (count > 200) {
      descInput.classList.add("is-invalid");
    } else {
      descInput.classList.remove("is-invalid");
    }
  });

  // Prevent submit if invalid
  document.querySelector("form").addEventListener("submit", function (e) {
    const titleCount = wordCount(titleInput.value);
    const descCount = wordCount(descInput.value);

    if (titleCount > 30 || descCount > 200) {
      e.preventDefault();

      if (titleCount > 30) {
        titleInput.classList.add("is-invalid");
      }

      if (descCount > 200) {
        descInput.classList.add("is-invalid");
      }
    }
  });
</script>