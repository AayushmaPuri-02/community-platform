<style>
  .comment-block {
    background: #f8f9fb;
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 8px;
  }

  .comment-block.pinned {
    background: #fffbeb;
    border: 1px solid #fde68a;
  }

  .comment-author-link {
    color: #04888D;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .action-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: 0.9rem;
    color: #adb5bd;
  }

  .action-btn:hover {
    color: #495057;
  }
</style>

<div class="container py-4" style="max-width:820px;">

  <p class="mb-4"><a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">← Back</a></p>

  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">

      <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="d-flex align-items-center gap-3">
          <a href="/users/<%= post.author._id %>">
            <img src="<%= post.author.profileImage || '/images/default-avatar.png' %>"
              alt="<%= post.author.communityName || post.author.organizationName || post.author.fullName %>"
              class="rounded-circle border" style="width:40px; height:40px; object-fit:cover;">
          </a>
          <div>
            <a href="/users/<%= post.author._id %>" class="fw-semibold text-dark text-decoration-none"
              style="font-size:14px;">
              <%= post.author.communityName || post.author.organizationName || post.author.fullName %>
            </a>
            <div class="text-muted" style="font-size:11.5px;">
              <% var _diff=Date.now() - new Date(post.createdAt).getTime(); var _mins=Math.floor(_diff / 60000); var
                _hrs=Math.floor(_diff / 3600000); var _timeStr; if (_mins < 1) _timeStr='just now' ; else if (_mins <
                60) _timeStr=_mins + ' min ago' ; else if (_hrs < 24) _timeStr=_hrs + ' hour' + (_hrs===1 ? '' : 's' )
                + ' ago' ; else _timeStr=new Date(post.createdAt).toLocaleDateString('en-GB', { day:'numeric',
                month:'long', year:'numeric' }); %>
                <%= _timeStr %>
            </div>
          </div>
        </div>
        <% if (userId && post.author._id.toString()===userId.toString()) { %>
          <div class="d-flex gap-2 ms-3">
            <a href="/posts/<%= post._id %>/edit" class="btn btn-sm btn-light border" title="Edit"><i
                class="bi bi-pencil"></i></a>
            <button type="button" class="btn btn-sm btn-light border text-danger" title="Delete" data-bs-toggle="modal"
              data-bs-target="#deletePostModal"><i class="bi bi-trash"></i></button>
          </div>
          <% } %>
      </div>

      <h1 class="fw-bold mb-3" style="color:#04888D; font-size:1.5rem;">
        <%= post.title %>
      </h1>

      <% if (post.type==="volunteer" ) { %>
        <div class="mb-4 p-3 bg-light rounded-3 border" style="font-size:0.9rem;">
          <% if (post.volunteerDate) { %>
            <span class="me-3"><i class="bi bi-calendar-event me-1"></i>
              <strong>Date:</strong>
              <%= new Date(post.volunteerDate).toLocaleDateString("en-GB", { day:"numeric", month:"long", year:"numeric"
                }) %>
            </span>
            <% } %>
              <span>
                <i class="bi bi-people me-1"></i>
                <strong>Volunteers:</strong>
                <% var activeVolCount=post.volunteers.filter(function(v){ return v.status==='pending' ||
                  v.status==='attended' ; }).length; %>
                  <%= activeVolCount %>
                    <% if (post.maxVolunteers> 0) { %> / <%= post.maxVolunteers %>
                        <% } %>
              </span>
        </div>
        <% } %>

          <% if (post.type==="alert" ) { %>
            <div class="mb-4 p-3 rounded-3 border"
              style="font-size:0.9rem; background:#fff8f0; border-color:#fde68a !important;">
              <% var alertStatus=post.alertStatus==='Resolved' ? 'Resolved' : 'Active' ; %>
                <span class="me-3">
                  <% if (alertStatus==='Resolved' ) { %>
                    <span class="badge bg-secondary">Resolved</span>
                    <% } else { %>
                      <span class="badge bg-success">Active</span>
                      <% } %>
                </span>
                <% if (post.alertCategory) { %>
                  <span class="me-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                    <strong>Category:</strong>
                    <%= post.alertCategory %>
                  </span>
                  <% } %>
                    <% if (post.locationName) { %>
                      <% var _displayLocation=post.locationName; var _plusCodeRe=/^[A-Z0-9]{4,}\+[A-Z0-9]{2,}[^,]*,\s*/;
                        if (_plusCodeRe.test(_displayLocation)) { var _stripped=_displayLocation.replace(_plusCodeRe, ''
                        ).trim(); if (_stripped.split(',').length>= 2) { _displayLocation = _stripped; } } %>
                        <span class="me-3">
                          <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                          <strong>Location:</strong>
                          <%= _displayLocation %>
                        </span>
                        <% } %>
                          <% if (post.alertRadius) { %>
                            <span>
                              <i class="bi bi-broadcast me-1 text-primary"></i>
                              <strong>Affected Radius:</strong>
                              <%= post.alertRadius %>
                            </span>
                            <% } %>
            </div>
            <% if (userId && post.author._id.toString()===userId.toString() && alertStatus==='Active' ) { %>
              <div class="mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal"
                  data-bs-target="#resolveAlertModal">
                  <i class="bi bi-check2-circle me-1"></i>Mark as Resolved
                </button>
              </div>
              <% } %>
                <% if (post.latitude && post.longitude) { %>
                  <div id="alertDetailMap" class="mb-4"
                    style="height:200px; border-radius:8px; overflow:hidden; border:1px solid #e2e8f0;"></div>
                  <% } %>
                    <% } %>

                      <% if (post.images && post.images.length> 0) { %>
                        <% if (post.images.length===1) { %>
                          <div class="mb-4">
                            <img src="<%= post.images[0].url %>" alt="Post image" class="w-100 rounded-3"
                              style="max-height:420px; object-fit:contain; background:#f1f3f5;">
                          </div>
                          <% } else { %>
                            <div id="carousel-detail-<%= post._id %>" class="carousel slide mb-4" data-bs-ride="false"
                              data-bs-wrap="false">
                              <div class="carousel-inner rounded-3" style="max-height:420px;">
                                <% post.images.forEach(function(img, idx) { %>
                                  <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                    <img src="<%= img.url %>" class="d-block w-100 rounded-3"
                                      style="max-height:420px; object-fit:contain; background:#f1f3f5;"
                                      alt="Post image <%= idx + 1 %>">
                                  </div>
                                  <% }); %>
                              </div>
                              <button class="carousel-control-prev d-none" type="button"
                                data-bs-target="#carousel-detail-<%= post._id %>" data-bs-slide="prev"
                                style="width:40px;">
                                <span class="carousel-control-prev-icon"
                                  style="filter:invert(1) brightness(0.4);"></span>
                              </button>
                              <button class="carousel-control-next" type="button"
                                data-bs-target="#carousel-detail-<%= post._id %>" data-bs-slide="next"
                                style="width:40px;">
                                <span class="carousel-control-next-icon"
                                  style="filter:invert(1) brightness(0.4);"></span>
                              </button>
                              <div class="carousel-indicators" style="bottom:-20px;">
                                <% post.images.forEach(function(img, idx) { %>
                                  <button type="button" data-bs-target="#carousel-detail-<%= post._id %>"
                                    data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>"
                                    style="background:#adb5bd; width:7px; height:7px; border-radius:50%; border:none;">
                                  </button>
                                  <% }); %>
                              </div>
                            </div>
                            <div style="height:12px;"></div>
                            <% } %>
                              <% } else if (post.postImage && post.postImage.url) { %>
                                <img src="<%= post.postImage.url %>" alt="Post image" class="w-100 rounded-3 mb-4"
                                  style="max-height:420px; object-fit:contain; background:#f1f3f5;">
                                <% } %>

                                  <div class="text-secondary mb-3" style="line-height:1.8; font-size:1rem;">
                                    <%- renderedDescription %>
                                  </div>

                                  <% if (post.tags && post.tags.length> 0) { %>
                                    <div class="mb-4">
                                      <% post.tags.forEach(function(tag) { %>
                                        <span class="badge bg-light text-primary border rounded-pill me-1">#<%= tag %>
                                        </span>
                                        <% }); %>
                                    </div>
                                    <% } %>

                                      <div class="d-flex align-items-center gap-2 pt-3 border-top flex-wrap">
                                        <% var liked=false; if (userId) { for (var i=0; i < post.likes.length; i++) { if
                                          (post.likes[i].toString()===userId.toString()) { liked=true; break; } } } %>
                                          <button type="button" class="like-btn btn btn-sm btn-light border px-3"
                                            data-id="<%= post._id %>">
                                            <i class="bi <%= liked ? 'bi-heart-fill' : 'bi-heart' %>"
                                              style="<%= liked ? 'color:#dc3545;' : '' %>"></i>
                                            <span class="like-count ms-1">
                                              <%= post.likes.length %>
                                            </span>
                                          </button>

                                          <a href="#comments"
                                            class="btn btn-sm btn-light border px-3 text-decoration-none text-muted">
                                            <i class="bi bi-chat-dots"></i>
                                            <span class="ms-1">
                                              <%= comments.length %>
                                            </span>
                                          </a>

                                          <% var isSaved=false; if (userSavedPosts) { for (var j=0; j <
                                            userSavedPosts.length; j++) { if
                                            (userSavedPosts[j].toString()===post._id.toString()) { isSaved=true; break;
                                            } } } %>
                                            <button type="button" class="save-btn btn btn-sm btn-light border px-3"
                                              data-id="<%= post._id %>">
                                              <i class="bi <%= isSaved ? 'bi-bookmark-fill' : 'bi-bookmark' %>"
                                                style="<%= isSaved ? 'color:#f59e0b;' : '' %>"></i>
                                            </button>

                                            <% if (userId && post.author._id.toString() !==userId.toString()) { %>
                                              <button type="button" class="btn btn-sm btn-light border px-3 text-danger"
                                                data-bs-toggle="modal" data-bs-target="#reportModal"
                                                title="Report this post">
                                                <i class="bi bi-flag"></i>
                                              </button>
                                              <% } %>

                                                <% if (userId) { %>
                                                  <button type="button" class="btn btn-sm btn-light border px-3"
                                                    data-bs-toggle="modal" data-bs-target="#shareModal"
                                                    title="Share this post">
                                                    <i class="bi bi-share"></i>
                                                  </button>
                                                  <% } %>

                                                    <!-- Type badge bottom-right -->
                                                    <% var _bClass='bg-secondary' ; %>
                                                      <% if (post.type==='alert' ) { _bClass='bg-danger' ; } %>
                                                        <% if (post.type==='volunteer' ) { _bClass='bg-success' ; } %>
                                                          <% if (post.type==='event' ) { _bClass='bg-primary' ; } %>
                                                            <% if (post.type==='notice' ) { _bClass='bg-secondary' ; }
                                                              %>
                                                              <% if (post.type==='training' ) { _bClass='bg-info' ; } %>
                                                                <% if (post.type==='communityUpdate' ) {
                                                                  _bClass='bg-warning text-dark' ; } %>
                                                                  <% var _bLabel=post.type==='communityUpdate'
                                                                    ? 'Update' :
                                                                    post.type.charAt(0).toUpperCase()+post.type.slice(1);
                                                                    %>
                                                                    <span
                                                                      class="ms-auto badge <%= _bClass %> rounded-pill"
                                                                      style="font-size:0.72rem;">
                                                                      <%= _bLabel %>
                                                                    </span>
                                      </div>

    </div>
  </div>

  <% if (post.type==="volunteer" ) { %>

    <% var alreadyJoined=false; var myRejected=false; var _activeVolCount=post.volunteers.filter(function(v){ return
      v.status==='pending' || v.status==='attended' ; }).length; var slotsFull=post.maxVolunteers> 0 && _activeVolCount
      >= post.maxVolunteers;
      if (userId) {
      for (var vi = 0; vi < post.volunteers.length; vi++) { if (post.volunteers[vi].user &&
        post.volunteers[vi].user.toString()===userId.toString()) { if (post.volunteers[vi].status==='rejected' ) {
        myRejected=true; } else { alreadyJoined=true; } break; } } } var isAuthor=userId &&
        post.author._id.toString()===userId.toString(); %>

        <% if (userId && !isAuthor) { %>
          <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
              <h5 class="fw-bold mb-3">Volunteer for this Post</h5>
              <% if (alreadyJoined) { var myEntry=null; for (var vi2=0; vi2 < post.volunteers.length; vi2++) { if
                (post.volunteers[vi2].user && post.volunteers[vi2].user.toString()===userId.toString()) {
                myEntry=post.volunteers[vi2]; break; } } var myStatus=myEntry ? (myEntry.status || (myEntry.attended
                ? 'attended' : 'pending' )) : 'pending' ; %>
                <% if (myStatus==='attended' ) { %>
                  <span class="badge bg-success px-3 py-2" style="font-size:0.9rem;">
                    <i class="bi bi-check-circle me-1"></i> Attended
                  </span>
                  <% } else if (myStatus==='rejected' ) { %>
                    <div>
                      <span class="badge bg-danger px-3 py-2 mb-2" style="font-size:0.9rem;">
                        <i class="bi bi-x-circle me-1"></i> Application Rejected
                      </span>
                      <% if (myEntry && myEntry.rejectionReason) { %>
                        <p class="text-muted small mt-2 mb-0">
                          <strong>Reason:</strong>
                          <%= myEntry.rejectionReason %>
                        </p>
                        <% } %>
                    </div>
                    <% } else { %>
                      <% var canCancel=false; if (post.volunteerDate) { var cutoffDate=new Date(post.volunteerDate);
                        cutoffDate.setDate(cutoffDate.getDate() - 2); cutoffDate.setHours(0, 0, 0, 0); var todayDate=new
                        Date(); todayDate.setHours(0, 0, 0, 0); canCancel=todayDate < cutoffDate; } %>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                          <span class="badge bg-success px-3 py-2" style="font-size:0.9rem;">
                            <i class="bi bi-check-circle me-1"></i> Already Joined
                          </span>
                          <% if (canCancel) { %>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                              data-bs-toggle="modal" data-bs-target="#cancelVolunteerModal">
                              Cancel Signup
                            </button>
                            <% } else if (post.volunteerDate) { %>
                              <small class="text-muted">Cancellation not available within 2 days of the event.</small>
                              <% } %>
                        </div>
                        <% } %>
                          <% } else if (myRejected) { %>
                            <% var myRejEntry=null; for (var vir=0; vir < post.volunteers.length; vir++) { if
                              (post.volunteers[vir].user && post.volunteers[vir].user.toString()===userId.toString()) {
                              myRejEntry=post.volunteers[vir]; break; } } %>
                              <div class="alert alert-danger py-2 px-3 mb-0" style="font-size:0.9rem;">
                                <i class="bi bi-x-circle me-1"></i>
                                <strong>Your volunteer application was rejected.</strong>
                                <% if (myRejEntry && myRejEntry.rejectionReason) { %>
                                  <div class="mt-1 text-danger" style="font-size:0.85rem;">
                                    <strong>Reason:</strong>
                                    <%= myRejEntry.rejectionReason %>
                                  </div>
                                  <% } %>
                              </div>
                              <% } else if (slotsFull) { %>
                                <span class="badge bg-secondary px-3 py-2" style="font-size:0.9rem;">Volunteer limit
                                  reached</span>
                                <% } else { %>
                                  <button class="btn btn-success px-4 rounded-pill" data-bs-toggle="modal"
                                    data-bs-target="#volunteerModal">
                                    <i class="bi bi-hand-thumbs-up me-1"></i> Join as Volunteer
                                  </button>
                                  <% } %>
            </div>
          </div>
          <% } %>

            <% if (isAuthor) { %>
              <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                  <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Manage volunteers from your <a
                      href="<%= role === 'organization' ? '/org-dashboard' : '/community-dashboard' %>"
                      class="text-decoration-none" style="color:#04888D;">Dashboard</a>.
                  </p>
                </div>
              </div>
              <% } %>

                <% } %>

                  <div class="card border-0 shadow-sm rounded-4 mb-5" id="comments">
                    <div class="card-body p-4">

                      <h5 class="fw-bold mb-4"><i class="bi bi-chat-left-dots me-2" style="color:#04888D;"></i>Comments
                        (<%= comments.length %>)</h5>

                      <form action="/posts/<%= post._id %>/comments" method="POST" class="mb-4" id="createCommentForm">
                        <label for="newCommentText" class="form-label text-muted small">Add a comment</label>
                        <textarea id="newCommentText" name="text" class="form-control" rows="3"
                          placeholder="Write a comment..." required></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                          <span class="form-text">Max 100 words.</span>
                          <button type="submit" class="btn btn-primary btn-sm px-4 rounded-pill">Post</button>
                        </div>
                        <div class="invalid-feedback">Comment must not exceed 100 words.</div>
                      </form>

                      <% if (comments.length===0) { %>
                        <p class="text-muted text-center py-3">No comments yet.</p>
                        <% } %>

                          <% comments.forEach(function(comment) { var replies=repliesByComment[comment._id.toString()]
                            || []; %>
                            <div class="comment-block <%= comment.isPinned ? 'pinned' : '' %>">
                              <div class="d-flex justify-content-between align-items-start">
                                <div>
                                  <a href="/users/<%= comment.author._id %>" class="comment-author-link">
                                    <%= comment.author.communityName || comment.author.organizationName ||
                                      comment.author.fullName %>
                                  </a>
                                  <% if (comment.isPinned) { %>
                                    <span class="badge ms-2"
                                      style="background:#fef3c7; color:#92400e; font-size:0.7rem;">Pinned</span>
                                    <% } %>
                                      <span class="text-muted ms-2" style="font-size:0.75rem;">
                                        <%= comment.createdAt.toLocaleDateString('en-GB', { day:'numeric',
                                          month:'short', year:'numeric' }) %>
                                      </span>
                                </div>
                                <div class="d-flex gap-3 align-items-center">
                                  <% if (userId && post.author._id.toString()===userId.toString()) { %>
                                    <form action="/comments/<%= comment._id %>/pin" method="POST"
                                      style="display:inline; margin:0;">
                                      <button type="submit" class="action-btn"
                                        title="<%= comment.isPinned ? 'Unpin' : 'Pin' %>">
                                        <i
                                          class="bi <%= comment.isPinned ? 'bi-pin-angle-fill text-warning' : 'bi-pin-angle' %>"></i>
                                      </button>
                                    </form>
                                    <% } %>
                                      <% if (userId && comment.author._id.toString()===userId.toString()) { %>
                                        <button type="button" class="action-btn" title="Edit" data-bs-toggle="modal"
                                          data-bs-target="#editCommentModal" data-comment-id="<%= comment._id %>"
                                          data-comment-text="<%= encodeURIComponent(comment.text) %>">
                                          <i class="bi bi-pencil-square" style="color:#04888D;"></i>
                                        </button>
                                        <% } %>
                                          <% if (userId && (comment.author._id.toString()===userId.toString() ||
                                            post.author._id.toString()===userId.toString())) { %>
                                            <button type="button" class="action-btn text-danger" title="Delete"
                                              data-bs-toggle="modal" data-bs-target="#deleteCommentModal"
                                              data-comment-id="<%= comment._id %>">
                                              <i class="bi bi-trash"></i>
                                            </button>
                                            <% } %>
                                              <% if (userId) { %>
                                                <button type="button" class="action-btn" title="Reply"
                                                  onclick="toggleReplyForm('replyForm-<%= comment._id %>')">
                                                  <i class="bi bi-reply" style="color:#04888D;"></i>
                                                </button>
                                                <% } %>
                                </div>
                              </div>

                              <p class="mb-0 mt-2 text-secondary" style="font-size:0.95rem; line-height:1.6;">
                                <%= comment.text %>
                              </p>

                              <% /* Inline reply form — hidden by default */%>
                                <% if (userId) { %>
                                  <div id="replyForm-<%= comment._id %>" style="display:none;" class="mt-2">
                                    <form action="/posts/<%= post._id %>/comments/<%= comment._id %>/reply"
                                      method="POST">
                                      <div class="input-group input-group-sm">
                                        <input type="text" name="text" class="form-control rounded-start"
                                          placeholder="Write a reply… (max 100 words)" required>
                                        <button type="submit" class="btn btn-success btn-sm">Reply</button>
                                      </div>
                                    </form>
                                  </div>
                                  <% } %>

                                    <% /* Replies section */%>
                                      <% if (replies.length> 0) { %>
                                        <div class="mt-2">
                                          <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                            style="font-size:0.8rem; text-decoration:none;"
                                            onclick="toggleReplies('replies-<%= comment._id %>', this)">
                                            <i class="bi bi-chevron-down me-1"></i>
                                            <%= replies.length %>
                                              <%= replies.length===1 ? 'reply' : 'replies' %>
                                          </button>
                                          <div id="replies-<%= comment._id %>" style="display:none;"
                                            class="mt-2 ps-3 border-start border-2">
                                            <% replies.forEach(function(reply) { %>
                                              <div class="comment-block mb-2" style="background:#f0f4f8;">
                                                <div class="d-flex justify-content-between align-items-start">
                                                  <div>
                                                    <a href="/users/<%= reply.author._id %>"
                                                      class="comment-author-link">
                                                      <%= reply.author.communityName || reply.author.organizationName ||
                                                        reply.author.fullName %>
                                                    </a>
                                                    <span class="text-muted ms-2" style="font-size:0.75rem;">
                                                      <%= reply.createdAt.toLocaleDateString('en-GB', { day:'numeric',
                                                        month:'short', year:'numeric' }) %>
                                                    </span>
                                                  </div>
                                                  <div class="d-flex gap-3 align-items-center">
                                                    <% if (userId && reply.author._id.toString()===userId.toString()) {
                                                      %>
                                                      <button type="button" class="action-btn" title="Edit"
                                                        data-bs-toggle="modal" data-bs-target="#editCommentModal"
                                                        data-comment-id="<%= reply._id %>"
                                                        data-comment-text="<%= encodeURIComponent(reply.text) %>">
                                                        <i class="bi bi-pencil-square" style="color:#04888D;"></i>
                                                      </button>
                                                      <% } %>
                                                        <% if (userId &&
                                                          (reply.author._id.toString()===userId.toString() ||
                                                          post.author._id.toString()===userId.toString())) { %>
                                                          <button type="button" class="action-btn text-danger"
                                                            title="Delete" data-bs-toggle="modal"
                                                            data-bs-target="#deleteCommentModal"
                                                            data-comment-id="<%= reply._id %>">
                                                            <i class="bi bi-trash"></i>
                                                          </button>
                                                          <% } %>
                                                            <% if (userId) { %>
                                                              <button type="button" class="action-btn" title="Reply"
                                                                onclick="toggleReplyForm('replyForm-<%= comment._id %>')">
                                                                <i class="bi bi-reply" style="color:#04888D;"></i>
                                                              </button>
                                                              <% } %>
                                                  </div>
                                                </div>
