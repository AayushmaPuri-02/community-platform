<div class="container py-4">
  <p class="mb-3">
    <a href="<%= backUrl %>" class="btn btn-outline-secondary btn-sm rounded-3">← Back</a>
  </p>

  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-3">
      <div class="flex-grow-1">
        <h1 class="mb-3 fw-bold" style="color:#04888D; font-size: 2rem;"><%= post.title %></h1>

        <div class="text-muted d-flex flex-wrap align-items-center gap-5" style="font-size: 1rem;">
          <span class="d-inline-flex align-items-center">
            <strong class="me-2 text-dark">Type:</strong>
            <span class="text-capitalize"><%= post.type %></span>
          </span>

          <span class="d-inline-flex align-items-center">
            <strong class="me-2 text-dark">Posted by:</strong>
            <a href="/users/<%= post.author._id %>" class="text-decoration-none text-dark fw-semibold">
              <%= post.author.organizationName || post.author.fullName %>
            </a>
          </span>

          <span class="d-inline-flex align-items-center">
            <strong class="me-2 text-dark">Posted at:</strong>
            <span>
              <%= post.createdAt.toLocaleString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
                hour: "numeric",
                minute: "2-digit",
                hour12: true
              }) %>
            </span>
          </span>
        </div>
      </div>

      <% if (userId && post.author._id.toString() === userId.toString()) { %>
        <div class="d-flex gap-2">
          <a href="/posts/<%= post._id %>/edit" class="btn btn-light btn-sm rounded-circle border-0 text-primary shadow-sm" title="Edit">
            <i class="bi bi-pencil"></i>
          </a>

          <button
            type="button"
            class="btn btn-light btn-sm rounded-circle border-0 text-danger shadow-sm"
            title="Delete"
            data-bs-toggle="modal"
            data-bs-target="#deletePostModal"
          >
            <i class="bi bi-trash"></i>
          </button>
        </div>
      <% } %>
    </div>

   <% if (post.images && post.images.length > 0) { %>
  <div class="row g-3 mb-4">
    <% post.images.forEach(img => { %>
      <div class="<%= post.images.length === 1 ? 'col-12' : post.images.length === 2 ? 'col-md-6' : post.images.length === 3 ? 'col-md-4' : 'col-md-3' %>">
        <img
          src="<%= img.url %>"
          alt="Post image"
          class="w-100 rounded-4 shadow-sm"
          style="height: 350px; object-fit: cover;"
        >
      </div>
    <% }) %>
  </div>
<% } else if (post.postImage && post.postImage.url) { %>
  <img
    src="<%= post.postImage.url %>"
    alt="Post image"
    class="img-fluid rounded-4 mb-4 shadow-sm"
    style="height: 350px; width: 100%; object-fit: cover;"
  >
<% } %>

    <div class="mb-4">
    <div class="text-secondary" style="line-height:1.95; font-size: 1.08rem; font-weight: 400; white-space: pre-line;">
  <%= post.description %>
</div>
    </div>

    <p class="mb-4" style="font-size: 1rem;">
      <strong class="text-dark me-2">Tags:</strong>
      <%= post.tags.length ? post.tags.join(", ") : "No tags" %>
    </p>

    <div class="d-flex align-items-center gap-2">
      <% const liked = userId && post.likes.some(id => id.toString() === userId.toString()); %>
      <button
        type="button"
        class="like-btn btn btn-sm <%= liked ? 'btn-danger' : 'btn-light' %> border-0 px-3 py-2"
        data-id="<%= post._id %>">
        ❤️ <span class="like-count"><%= post.likes.length %></span>
      </button>

      <% const isSaved = userSavedPosts && userSavedPosts.some(id => id.toString() === post._id.toString()); %>
      <button
        type="button"
        class="save-btn btn btn-sm <%= isSaved ? 'btn-warning' : 'btn-light' %> border-0 px-3 py-2"
        data-id="<%= post._id %>">
        🔖
      </button>
    </div>
  </div>

  <!-- COMMENTS -->
  <div class="card border-0 shadow-sm rounded-4 mt-4 mb-5">
    <div class="card-body p-4">
      <h4 class="fw-bold mb-4" style="font-size: 1.25rem;">
        <i class="bi bi-chat-left-dots me-2"></i>Comments
      </h4>

      <form action="/posts/<%= post._id %>/comments" method="POST" class="mb-4" id="createCommentForm">
        <div class="mb-2">
          <textarea
            id="newCommentText"
            name="text"
            class="form-control rounded-3"
            placeholder="Write a comment..."
            style="height: 90px; font-size: 0.95rem;"
            required
          ></textarea>
          <div class="form-text">Maximum 100 words.</div>
          <div class="invalid-feedback">
            Comment must not exceed 100 words.
          </div>
        </div>
        <div class="text-end">
          <button type="submit" class="btn btn-success btn-sm px-4 rounded-pill">Post</button>
        </div>
      </form>

      <div class="comment-list">
        <% if (comments.length === 0) { %>
          <p class="text-muted text-center py-3" style="font-size: 0.95rem;">No comments yet.</p>
        <% } %>

        <% comments.forEach(comment => { %>
          <div class="py-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div class="d-flex align-items-center flex-wrap gap-3">
                <a href="/users/<%= comment.author._id %>" class="fw-bold text-decoration-none" style="font-size: 0.95rem; color: #333;">
                  <%= comment.author.organizationName || comment.author.fullName %>
                </a>

                <% if (comment.isPinned) { %>
                  <span class="text-warning" style="font-size: 0.85rem;" title="Pinned comment">
                    <i class="bi bi-pin-angle-fill"></i>
                  </span>
                <% } %>

                <span class="text-muted" style="font-size: 0.85rem;">
                  <%= comment.createdAt.toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                  }) %>
                </span>

                <div class="ms-3 d-flex gap-4 align-items-center">
                  <% if (userId && post.author._id.toString() === userId.toString()) { %>
                    <form action="/comments/<%= comment._id %>/pin" method="POST" style="display:inline;">
                      <button
                        type="submit"
                        class="btn btn-link p-0 border-0 text-decoration-none"
                        style="font-size: 0.9rem; color: #6c757d;"
                        title="<%= comment.isPinned ? 'Unpin comment' : 'Pin comment' %>"
                      >
                        <i class="bi <%= comment.isPinned ? 'bi-pin-angle-fill text-warning' : 'bi-pin-angle' %>"></i>
                      </button>
                    </form>
                  <% } %>

                  <% if (userId && comment.author._id.toString() === userId.toString()) { %>
                    <button
                      type="button"
                      class="btn btn-link p-0 border-0 text-decoration-none"
                      style="font-size: 1rem; color: #04888D;"
                      title="Edit comment"
                      data-bs-toggle="modal"
                      data-bs-target="#editCommentModal"
                      data-comment-id="<%= comment._id %>"
                      data-comment-text="<%- comment.text.replace(/"/g, '&quot;') %>"
                    >
                      <i class="bi bi-pencil-square"></i>
                    </button>
                  <% } %>

                  <% if (userId && (comment.author._id.toString() === userId.toString() || post.author._id.toString() === userId.toString())) { %>
                    <button
                      type="button"
                      class="btn btn-link p-0 border-0 text-decoration-none text-danger"
                      style="font-size: 1rem;"
                      title="Delete comment"
                      data-bs-toggle="modal"
                      data-bs-target="#deleteCommentModal"
                      data-comment-id="<%= comment._id %>"
                    >
                      <i class="bi bi-trash"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>

            <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
              <%= comment.text %>
            </p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<!-- DELETE POST MODAL -->
<% if (userId && post.author._id.toString() === userId.toString()) { %>
  <div class="modal fade" id="deletePostModal" tabindex="-1" aria-labelledby="deletePostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-danger" id="deletePostModalLabel">Delete Post</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body pt-2">
          <p class="mb-2" style="font-size: 1rem;">
            Are you sure you want to delete this post?
          </p>
          <p class="text-muted mb-0" style="font-size: 0.95rem;">
            This action cannot be undone.
          </p>
        </div>

        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>

          <form action="/posts/<%= post._id %>/delete" method="POST" class="m-0">
            <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<!-- SHARED EDIT COMMENT MODAL -->
<div class="modal fade" id="editCommentModal" tabindex="-1" aria-labelledby="editCommentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="editCommentModalLabel">Edit Comment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="sharedEditCommentForm" method="POST">
        <div class="modal-body pt-2">
          <textarea
            id="sharedEditCommentTextarea"
            name="text"
            class="form-control rounded-3"
            rows="4"
            required
          ></textarea>
          <div class="form-text">Maximum 100 words.</div>
          <div class="invalid-feedback">
            Comment must not exceed 100 words.
          </div>
        </div>

        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- SHARED DELETE COMMENT MODAL -->
<div class="modal fade" id="deleteCommentModal" tabindex="-1" aria-labelledby="deleteCommentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="deleteCommentModalLabel">Delete Comment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body pt-2">
        <p class="mb-2" style="font-size: 1rem;">
          Are you sure you want to delete this comment?
        </p>
        <p class="text-muted mb-0" style="font-size: 0.95rem;">
          This action cannot be undone.
        </p>
      </div>

      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>

        <form id="sharedDeleteCommentForm" method="POST" class="m-0">
          <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function countWords(text) {
  return text.trim().split(/\s+/).filter(Boolean).length;
}

function validateCommentTextarea(textarea) {
  const words = countWords(textarea.value);

  if (words > 100) {
    textarea.classList.add("is-invalid");
    return false;
  } else {
    textarea.classList.remove("is-invalid");
    return true;
  }
}

// Create comment validation
const createCommentForm = document.getElementById("createCommentForm");
const newCommentText = document.getElementById("newCommentText");

if (newCommentText && createCommentForm) {
  newCommentText.addEventListener("input", function () {
    validateCommentTextarea(newCommentText);
  });

  createCommentForm.addEventListener("submit", function (e) {
    if (!validateCommentTextarea(newCommentText)) {
      e.preventDefault();
    }
  });
}

// Shared edit comment modal logic
const sharedEditCommentForm = document.getElementById("sharedEditCommentForm");
const sharedEditCommentTextarea = document.getElementById("sharedEditCommentTextarea");
const sharedDeleteCommentForm = document.getElementById("sharedDeleteCommentForm");

document.querySelectorAll('[data-bs-target="#editCommentModal"]').forEach(button => {
  button.addEventListener("click", () => {
    const commentId = button.getAttribute("data-comment-id");
    const commentText = button.getAttribute("data-comment-text");

    sharedEditCommentForm.action = `/comments/${commentId}/edit`;
    sharedEditCommentTextarea.value = commentText || "";
    sharedEditCommentTextarea.classList.remove("is-invalid");
  });
});

document.querySelectorAll('[data-bs-target="#deleteCommentModal"]').forEach(button => {
  button.addEventListener("click", () => {
    const commentId = button.getAttribute("data-comment-id");
    sharedDeleteCommentForm.action = `/comments/${commentId}/delete`;
  });
});

if (sharedEditCommentTextarea && sharedEditCommentForm) {
  sharedEditCommentTextarea.addEventListener("input", function () {
    validateCommentTextarea(sharedEditCommentTextarea);
  });

  sharedEditCommentForm.addEventListener("submit", function (e) {
    if (!validateCommentTextarea(sharedEditCommentTextarea)) {
      e.preventDefault();
    }
  });
}

// Like button
document.querySelectorAll(".like-btn").forEach(button => {
  button.addEventListener("click", async () => {
    const postId = button.dataset.id;

    try {
      const res = await fetch(`/posts/${postId}/like`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        }
      });

      const data = await res.json();

      if (data.success) {
        const countSpan = button.querySelector(".like-count");
        countSpan.innerText = data.likeCount;

        if (data.liked) {
          button.classList.remove("btn-light");
          button.classList.add("btn-danger");
        } else {
          button.classList.remove("btn-danger");
          button.classList.add("btn-light");
        }
      }
    } catch (err) {
      console.error("Like error:", err);
    }
  });
});

// Save button
document.querySelectorAll(".save-btn").forEach(button => {
  button.addEventListener("click", async () => {
    const postId = button.dataset.id;

    try {
      const res = await fetch(`/posts/${postId}/save`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        }
      });

      const data = await res.json();

      if (data.success) {
        if (data.saved) {
          button.classList.remove("btn-light");
          button.classList.add("btn-warning");
        } else {
          button.classList.remove("btn-warning");
          button.classList.add("btn-light");
        }
      }
    } catch (err) {
      console.error("Save error:", err);
    }
  });
});
</script>