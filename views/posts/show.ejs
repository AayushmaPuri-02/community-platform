                        <script>
                          function showToast(msg) {
                            var t = document.getElementById('saveToast');
                            document.getElementById('saveToastMsg').innerText = msg;
                            t.style.display = 'block';
                            setTimeout(function () { t.style.display = 'none'; }, 2000);
                          }

                          function toggleReplyForm(id) {
                            var el = document.getElementById(id);
                            if (!el) return;
                            el.style.display = el.style.display === 'none' ? 'block' : 'none';
                            if (el.style.display === 'block') {
                              var input = el.querySelector('input[name="text"]');
                              if (input) input.focus();
                            }
                          }

                          function toggleReplies(id, btn) {
                            var el = document.getElementById(id);
                            if (!el) return;
                            var icon = btn.querySelector('i');
                            if (el.style.display === 'none') {
                              el.style.display = 'block';
                              if (icon) { icon.classList.remove('bi-chevron-down'); icon.classList.add('bi-chevron-up'); }
                            } else {
                              el.style.display = 'none';
                              if (icon) { icon.classList.remove('bi-chevron-up'); icon.classList.add('bi-chevron-down'); }
                            }
                          }

                          function countWords(str) {
                            if (!str.trim()) return 0;
                            return str.trim().split(' ').filter(function (w) { return w !== ''; }).length;
                          }

                          function validateTextarea(el) {
                            if (countWords(el.value) > 100) { el.classList.add('is-invalid'); return false; }
                            el.classList.remove('is-invalid'); return true;
                          }

                          var createForm = document.getElementById('createCommentForm');
                          var newText = document.getElementById('newCommentText');
                          if (newText) {
                            newText.addEventListener('input', function () { validateTextarea(newText); });
                            createForm.addEventListener('submit', function (e) { if (!validateTextarea(newText)) e.preventDefault(); });
                          }

                          var editForm = document.getElementById('sharedEditCommentForm');
                          var editTextarea = document.getElementById('sharedEditCommentTextarea');
                          var deleteForm = document.getElementById('sharedDeleteCommentForm');

                          document.querySelectorAll('[data-bs-target="#editCommentModal"]').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                              editForm.action = '/comments/' + btn.getAttribute('data-comment-id') + '/edit';
                              editTextarea.value = decodeURIComponent(btn.getAttribute('data-comment-text') || '');
                              editTextarea.classList.remove('is-invalid');
                            });
                          });

                          document.querySelectorAll('[data-bs-target="#deleteCommentModal"]').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                              deleteForm.action = '/comments/' + btn.getAttribute('data-comment-id') + '/delete';
                            });
                          });

                          if (editTextarea) {
                            editTextarea.addEventListener('input', function () { validateTextarea(editTextarea); });
                            editForm.addEventListener('submit', function (e) { if (!validateTextarea(editTextarea)) e.preventDefault(); });
                          }

                          document.querySelectorAll('.like-btn').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                              var postId = btn.dataset.id;
                              var icon = btn.querySelector('i');
                              fetch('/posts/' + postId + '/like', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                                .then(function (r) { return r.json(); })
                                .then(function (data) {
                                  if (data.success) {
                                    btn.querySelector('.like-count').innerText = data.likeCount;
                                    if (data.liked) { icon.className = 'bi bi-heart-fill'; icon.style.color = '#dc3545'; }
                                    else { icon.className = 'bi bi-heart'; icon.style.color = ''; }
                                  }
                                })
                                .catch(function (e) { console.error(e); });
                            });
                          });

                          document.querySelectorAll('.save-btn').forEach(function (btn) {
                            btn.addEventListener('click', function () {
                              var postId = btn.dataset.id;
                              var icon = btn.querySelector('i');
                              fetch('/posts/' + postId + '/save', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                                .then(function (r) { return r.json(); })
                                .then(function (data) {
                                  if (data.success) {
                                    if (data.saved) {
                                      icon.className = 'bi bi-bookmark-fill'; icon.style.color = '#f59e0b';
                                      showToast('Saved');
                                    } else {
                                      icon.className = 'bi bi-bookmark'; icon.style.color = '';
                                      showToast('Unsaved');
                                    }
                                  }
                                })
                                .catch(function (e) { console.error(e); });
                            });
                          });

                          // ── Share feature ──────────────────────────────────────
                          (function () {
                            var postId = '<%= post._id %>';
                            var postTitle = '<%= post.title %>';
                            var postUrl = window.location.origin + '/posts/' + postId;

                            // Update WhatsApp href with real origin (replaces the server-rendered localhost)
                            var waBtn = document.getElementById('whatsappShareBtn');
                            if (waBtn) {
                              waBtn.href = 'https://wa.me/?text=' + encodeURIComponent(postTitle + ' — ' + postUrl);
                            }

                            // Update message preview with real origin
                            var msgPreview = document.getElementById('msgPreview');
                            if (msgPreview) {
                              msgPreview.value = 'Shared a post: ' + postTitle + ' — ' + postUrl;
                            }

                            // Copy link
                            var copyBtn = document.getElementById('copyLinkBtn');
                            var copyMsg = document.getElementById('copyLinkMsg');
                            if (copyBtn) {
                              copyBtn.addEventListener('click', function () {
                                if (navigator.clipboard) {
                                  navigator.clipboard.writeText(postUrl).then(function () {
                                    copyMsg.style.display = 'inline';
                                    setTimeout(function () { copyMsg.style.display = 'none'; }, 2000);
                                  });
                                } else {
                                  // Fallback for older browsers
                                  var ta = document.createElement('textarea');
                                  ta.value = postUrl;
                                  document.body.appendChild(ta);
                                  ta.select();
                                  document.execCommand('copy');
                                  document.body.removeChild(ta);
                                  copyMsg.style.display = 'inline';
                                  setTimeout(function () { copyMsg.style.display = 'none'; }, 2000);
                                }
                              });
                            }

                            // Open send-in-message modal from share modal
                            var openSendBtn = document.getElementById('openSendMsgBtn');
                            if (openSendBtn) {
                              openSendBtn.addEventListener('click', function () {
                                // Close share modal, open message modal
                                var shareModalEl = document.getElementById('shareModal');
                                var sendModalEl = document.getElementById('sendMsgModal');
                                bootstrap.Modal.getInstance(shareModalEl).hide();
                                setTimeout(function () {
                                  new bootstrap.Modal(sendModalEl).show();
                                }, 300);
                              });
                            }

                            // Load recipients when send modal opens
                            var sendModalEl = document.getElementById('sendMsgModal');
                            var recipientSelect = document.getElementById('msgRecipientSelect');
                            var recipientsLoaded = false;
                            if (sendModalEl) {
                              sendModalEl.addEventListener('show.bs.modal', function () {
                                if (recipientsLoaded) return;
                                fetch('/share/recipients')
                                  .then(function (r) { return r.json(); })
                                  .then(function (list) {
                                    recipientSelect.innerHTML = '<option value="">— Choose a recipient —</option>';
                                    list.forEach(function (u) {
                                      var opt = document.createElement('option');
                                      opt.value = u._id;
                                      opt.textContent = u.name + ' (' + u.role + ')';
                                      recipientSelect.appendChild(opt);
                                    });
                                    recipientsLoaded = true;
                                  })
                                  .catch(function () {
                                    recipientSelect.innerHTML = '<option value="">Could not load recipients</option>';
                                  });
                              });
                            }

                            // Send message
                            var sendConfirmBtn = document.getElementById('sendMsgConfirmBtn');
                            var sendMsgError = document.getElementById('sendMsgError');
                            if (sendConfirmBtn) {
                              sendConfirmBtn.addEventListener('click', function () {
                                var recipientId = recipientSelect.value;
                                if (!recipientId) {
                                  sendMsgError.textContent = 'Please select a recipient.';
                                  sendMsgError.style.display = 'block';
                                  return;
                                }
                                sendMsgError.style.display = 'none';
                                sendConfirmBtn.disabled = true;
                                sendConfirmBtn.textContent = 'Sending…';

                                var form = document.createElement('form');
                                form.method = 'POST';
                                form.action = '/messages/' + recipientId;
                                var input = document.createElement('input');
                                input.type = 'hidden';
                                input.name = 'text';
                                input.value = msgPreview.value;
                                form.appendChild(input);
                                document.body.appendChild(form);
                                form.submit();
                              });
                            }
                          })();
                        </script>
                        <script>
                          // Carousel arrow visibility — no wrap, hide arrows at boundaries
                          document.querySelectorAll('.carousel[data-bs-wrap="false"]').forEach(function (el) {
                            var items = el.querySelectorAll('.carousel-item');
                            var total = items.length;
                            var prevBtn = el.querySelector('.carousel-control-prev');
                            var nextBtn = el.querySelector('.carousel-control-next');

                            function updateArrows() {
                              var activeIdx = Array.from(items).findIndex(function (item) {
                                return item.classList.contains('active');
                              });
                              if (prevBtn) prevBtn.classList.toggle('d-none', activeIdx === 0);
                              if (nextBtn) nextBtn.classList.toggle('d-none', activeIdx === total - 1);
                            }

                            updateArrows();
                            el.addEventListener('slid.bs.carousel', updateArrows);
                          });
                        </script>

                        <% if (post.type==='alert' && post.latitude && post.longitude) { %>
                          <script>
                            (function () {
                              var script = document.createElement('script');
                              script.src = 'https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initAlertDetailMap&loading=async';
                              script.async = true;
                              document.head.appendChild(script);

                              window.initAlertDetailMap = function () {
                                var mapDiv = document.getElementById('alertDetailMap');
                                if (!mapDiv) return;
                                var pos = { lat: <%= post.latitude %>, lng: <%= post.longitude %> };
                                var map = new google.maps.Map(mapDiv, {
                                  center: pos,
                                  zoom: 15,
                                  disableDefaultUI: true,
                                  zoomControl: true,
                                });
                                new google.maps.Marker({ position: pos, map: map });
                              };
                            })();
                          </script>
                          <% } %>

                            <script>
                              (function () {
                                var noteInput = document.getElementById('reportNoteInput');
                                var noteCount = document.getElementById('reportNoteCount');
                                var noteError = document.getElementById('reportNoteError');
                                var submitBtn = document.getElementById('reportSubmitBtn');

                                if (!noteInput) return;

                                var lastValidValue = '';

                                function countWords(str) {
                                  return str.trim() === '' ? 0 : str.trim().split(/\s+/).filter(Boolean).length;
                                }

                                noteInput.addEventListener('input', function () {
                                  var words = countWords(this.value);

                                  if (words > 10) {
                                    // Hard block: restore last valid value
                                    this.value = lastValidValue;
                                    words = countWords(lastValidValue);
                                  } else {
                                    lastValidValue = this.value;
                                  }

                                  noteCount.textContent = words + ' / 10 words';
                                  noteCount.style.color = words === 10 ? '#f59e0b' : '#6c757d';
                                  noteError.style.display = 'none';
                                  noteInput.classList.remove('is-invalid');
                                  submitBtn.disabled = false;
                                });

                                // Reset state when modal is closed
                                var reportModal = document.getElementById('reportModal');
                                if (reportModal) {
                                  reportModal.addEventListener('hidden.bs.modal', function () {
                                    noteInput.value = '';
                                    lastValidValue = '';
                                    noteCount.textContent = '0 / 10 words';
                                    noteCount.style.color = '#6c757d';
                                    noteError.style.display = 'none';
                                    noteInput.classList.remove('is-invalid');
                                    submitBtn.disabled = false;
                                  });
                                }
                              })();
                            </script>