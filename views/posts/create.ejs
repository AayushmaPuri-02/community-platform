<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <h1 class="mb-3">Create Post</h1>

      <p>
        <a href="/home" class="btn btn-outline-secondary btn-sm mb-3">← Back to Home</a>
      </p>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <form id="createPostForm" action="/posts" method="POST" enctype="multipart/form-data" >

            <div class="mb-3">
              <label for="title" class="form-label fw-bold">Title</label>
              <input
                type="text"
                id="title"
                name="title"
                class="form-control"
                placeholder="Enter post title"
                required
              >
              <div class="form-text">
                Maximum 30 words.
              </div>
              <div class="invalid-feedback" id="titleError">
                Title must not exceed 30 words.
              </div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label fw-bold">Description</label>
              <textarea
                id="description"
                name="description"
                class="form-control"
                rows="5"
                placeholder="What's on your mind?"
                required
              ></textarea>
              <div class="form-text">
                Maximum 200 words.
              </div>
              <div class="invalid-feedback" id="descriptionError">
                Description must not exceed 200 words.
              </div>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="type" class="form-label fw-bold">Type</label>
                <select id="type" name="type" class="form-select" required>
                  <option value="" selected disabled>Choose a category...</option>
                  <option value="event">Event</option>
                  <option value="volunteer">Volunteer</option>
                  <option value="alert">Alert</option>
                  <option value="training">Training</option>
                  <option value="communityUpdate">Community Update</option>
                </select>
              </div>

              <div class="col-md-6 mb-3">
                <label for="tags" class="form-label fw-bold">Tags</label>
                <input
                  type="text"
                  id="tags"
                  name="tags"
                  class="form-control"
                  placeholder="e.g. news, help, urgent"
                >
                <div class="form-text">Separate tags with commas.</div>
              </div>
            </div>

            <div class="mb-3">
              <label for="postImages" class="form-label fw-bold">Upload Images</label>
              <input
                type="file"
                id="postImages"
                name="postImages"
                class="form-control"
                multiple
                accept=".jpg,.jpeg,.png,image/jpeg,image/png"
              >
              <div class="form-text">
  You can upload up to 4 images. Allowed formats: JPG, JPEG, PNG. Maximum size: 1.5 MB per image.
</div>
<div class="invalid-feedback" id="postImagesError">
  Only JPG, JPEG, and PNG images under 1.5 MB are allowed.Maximum 4 images.
</div>
            </div>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <button type="submit" class="btn btn-primary px-4">Create Post</button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function countWords(text) {
    return text.trim().split(/\s+/).filter(Boolean).length;
  }

  const form = document.getElementById("createPostForm");
  const titleInput = document.getElementById("title");
  const descriptionInput = document.getElementById("description");
  const postImagesInput = document.getElementById("postImages");

  function validateTitle() {
    const titleWords = countWords(titleInput.value);

    if (titleWords > 30) {
      titleInput.classList.add("is-invalid");
      return false;
    } else {
      titleInput.classList.remove("is-invalid");
      return true;
    }
  }

  function validateDescription() {
    const descriptionWords = countWords(descriptionInput.value);

    if (descriptionWords > 200) {
      descriptionInput.classList.add("is-invalid");
      return false;
    } else {
      descriptionInput.classList.remove("is-invalid");
      return true;
    }
  }

  function validateImages() {
    const files = postImagesInput.files;
    const allowedTypes = ["image/jpeg", "image/png", "image/jpg"];
    const maxSize = 1.5 * 1024 * 1024;

    let valid = true;

    if (files.length > 4) {
      valid = false;
    }

    for (const file of files) {
      if (!allowedTypes.includes(file.type) || file.size > maxSize) {
        valid = false;
        break;
      }
    }

    if (!valid) {
      postImagesInput.classList.add("is-invalid");
      return false;
    } else {
      postImagesInput.classList.remove("is-invalid");
      return true;
    }
  }

  titleInput.addEventListener("input", validateTitle);
  descriptionInput.addEventListener("input", validateDescription);
  postImagesInput.addEventListener("change", validateImages);

  form.addEventListener("submit", function (e) {
    const isTitleValid = validateTitle();
    const isDescriptionValid = validateDescription();
    const areImagesValid = validateImages();

    if (!isTitleValid || !isDescriptionValid || !areImagesValid) {
      e.preventDefault();
    }
  });
</script>