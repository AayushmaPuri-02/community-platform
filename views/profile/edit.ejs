<% if (role==="citizen" ) { %>

  <div class="container py-5" style="max-width: 720px;">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-body p-4 p-md-5">

        <h2 class="fw-bold mb-3">Edit Profile</h2>

        <p class="text-muted mb-4">
          Update your personal details and profile image.
        </p>

        <form action="/profile/edit" method="POST" enctype="multipart/form-data">

          <div class="mb-4">
            <label class="form-label fw-semibold">Full Name</label>
            <input type="text" name="fullName" class="form-control" value="<%= user.fullName || '' %>"
              placeholder="Enter your full name" required>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Email Address</label>
            <input type="email" name="email" class="form-control" value="<%= user.email || '' %>"
              placeholder="Enter your email address" required>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Location</label>
            <div class="input-group">
              <input type="text" id="profileLocationInput" name="location" class="form-control"
                value="<%= user.locationName || user.location || '' %>"
                placeholder="Search your area or street address in Nepal">
              <button type="button" id="searchProfileLocationBtn" class="btn btn-outline-secondary">Search</button>
            </div>
            <div id="profileLocationMsg" class="form-text"></div>
            <div id="profileMapPreview"
              style="display:none;height:180px;border-radius:8px;overflow:hidden;margin-top:8px;border:1px solid #e2e8f0;">
            </div>
            <input type="hidden" id="locationNameInput" name="locationName" value="<%= user.locationName || '' %>">
            <input type="hidden" id="homeLatitudeInput" name="homeLatitude" value="<%= user.homeLatitude || '' %>">
            <input type="hidden" id="homeLongitudeInput" name="homeLongitude" value="<%= user.homeLongitude || '' %>">
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Profile Image</label>
            <input type="file" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png">
            <div class="form-text">
              Upload a profile picture if you want to personalize your account.
            </div>

            <% if (user.profileImage) { %>
              <div class="mt-3">
                <p class="mb-2 fw-semibold">Current Image</p>
                <img src="<%= user.profileImage %>" alt="Current profile image" class="img-thumbnail rounded-3"
                  style="max-width: 160px; max-height: 160px; object-fit: cover;">
              </div>
              <% } %>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Save Profile</button>
            <a href="/users/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>

  <% } else { %>


    <div class="container py-5" style="max-width: 760px;">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">

          <h2 class="fw-bold mb-3">
            <%= user.role==="organization" || user.role==="communityAdmin" ? "Complete Profile" : "Edit Profile" %>
          </h2>

          <% if (!user.profileCompleted) { %>
            <div class="alert alert-warning mb-4">
              <strong>Complete your profile to continue.</strong><br>
              Add the required public details before accessing the platform.
            </div>
            <% } %>

              <% if (user.role==="communityAdmin" ) { %>
                <div class="mb-4 p-3 bg-light rounded-3 border">
                  <p class="mb-1 text-muted small">Public community name (auto-generated, not editable)</p>
                  <strong>
                    <%= user.communityName || (user.location + ' Locals' ) %>
                  </strong>
                  <p class="mb-0 mt-1 text-muted small">Area: <%= user.location %>
                  </p>
                </div>
                <% } %>

                  <form action="/profile/edit" method="POST" enctype="multipart/form-data">

                    <div class="mb-4">
                      <label class="form-label fw-semibold">
                        <%= user.role==="communityAdmin" ? "Community Description"
                          : "Organization / Community Description" %>
                      </label>
                      <textarea name="bio" rows="5" class="form-control" id="bioTextarea"
                        placeholder="<%= user.role === 'communityAdmin' ? 'Briefly describe your community area, what kind of updates you post, and how residents can benefit.' : 'Briefly explain who you are, what your organization does, and the kind of support, events, or services you provide.' %>"><%= user.bio || "" %></textarea>
                      <div class="d-flex justify-content-between mt-1">
                        <span class="form-text">Maximum 150 words.</span>
                        <span class="form-text" id="bioCharCount">0 / 150 words</span>
                      </div>
                      <div class="invalid-feedback" id="bioError">Bio must not exceed 150 words.</div>
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">Public Phone Number</label>
                      <input type="text" name="publicPhone" class="form-control" value="<%= user.publicPhone || '' %>"
                        placeholder="e.g. 01-4XXXXXX, 98XXXXXXXX" required>
                      <div class="form-text">Nepal mobile (97/98...) or Kathmandu landline (01-...).</div>
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">Public Email</label>
                      <input type="email" name="publicEmail" class="form-control"
                        value="<%= user.publicEmail || user.email || '' %>" placeholder="public@example.com" required>
                      <div class="form-text">Email residents or the public can contact you at.</div>
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">Office Hours <span
                          class="text-muted fw-normal">(optional)</span></label>
                      <input type="text" name="officeHours" class="form-control" value="<%= user.officeHours || '' %>"
                        placeholder="e.g. Mon–Fri 9AM–5PM">
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">Social Media / Website Link</label>
                      <input type="text" name="socialMediaLink" class="form-control"
                        value="<%= user.socialMediaLink || "" %>"
                        placeholder="e.g. https://facebook.com/yourpage or https://yourwebsite.com">
                      <div class="form-text">
                        Optional. Add a public Facebook page, Instagram page, or website.
                      </div>
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">
                        <%= user.role==='communityAdmin' ? 'Contact Location' : 'Public Location' %>
                          <span class="text-muted fw-normal">(optional)</span>
                      </label>
                      <div class="input-group">
                        <input type="text" id="profileLocationInput" name="location" class="form-control"
                          value="<%= user.locationName || user.location || '' %>"
                          placeholder="Search your area or address in Nepal">
                        <button type="button" id="searchProfileLocationBtn"
                          class="btn btn-outline-secondary">Search</button>
                      </div>
                      <div id="profileLocationMsg" class="form-text"></div>
                      <div id="profileMapPreview"
                        style="display:none;height:180px;border-radius:8px;overflow:hidden;margin-top:8px;border:1px solid #e2e8f0;">
                      </div>
                      <input type="hidden" id="locationNameInput" name="locationName"
                        value="<%= user.locationName || '' %>">
                      <input type="hidden" id="homeLatitudeInput" name="homeLatitude"
                        value="<%= user.homeLatitude || '' %>">
                      <input type="hidden" id="homeLongitudeInput" name="homeLongitude"
                        value="<%= user.homeLongitude || '' %>">
                      <% if (user.role==='communityAdmin' ) { %>
                        <div class="form-text text-muted">Updates your contact coordinates only. Community area
                          assignment cannot be changed here.</div>
                        <% } %>
                    </div>

                    <div class="mb-4">
                      <label class="form-label fw-semibold">Profile Image</label>
                      <input type="file" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png">
                      <div class="form-text">
                        Upload your organization logo or a representative profile image.
                      </div>

                      <% if (user.profileImage) { %>
                        <div class="mt-3">
                          <p class="mb-2 fw-semibold">Current Image</p>
                          <img src="<%= user.profileImage %>" alt="Current profile image" class="img-thumbnail"
                            style="max-width: 180px; max-height: 180px; object-fit: cover;">
                        </div>
                        <% } %>
                    </div>

                    <div class="d-flex gap-2">
                      <button type="submit" class="btn btn-primary px-4">Save Profile</button>

                      <% if (user.profileCompleted) { %>
                        <a href="/users/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
                        <% } %>
                    </div>

                  </form>
        </div>
      </div>
    </div>

    <% } %>

      <script>
        var bioTextarea = document.getElementById('bioTextarea');
        var bioCharCount = document.getElementById('bioCharCount');
        if (bioTextarea && bioCharCount) {
          function countBioWords() {
            var val = bioTextarea.value.trim();
            return val === '' ? 0 : val.split(/\s+/).filter(Boolean).length;
          }
          function updateBioCount() {
            var words = countBioWords();
            bioCharCount.textContent = words + ' / 150 words';
            if (words > 150) {
              bioTextarea.classList.add('is-invalid');
              bioCharCount.style.color = '#dc3545';
            } else {
              bioTextarea.classList.remove('is-invalid');
              bioCharCount.style.color = '';
            }
          }
          bioTextarea.addEventListener('input', updateBioCount);
          updateBioCount();
        }
      </script>

      <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&loading=async"></script>
      <script>
        (function () {
          var searchBtn = document.getElementById('searchProfileLocationBtn');
          var input = document.getElementById('profileLocationInput');
          var msgDiv = document.getElementById('profileLocationMsg');
          var nameInput = document.getElementById('locationNameInput');
          var latInput = document.getElementById('homeLatitudeInput');
          var lngInput = document.getElementById('homeLongitudeInput');

          if (!searchBtn || !input) return;

          // Clear coords when user retypes
          input.addEventListener('input', function () {
            nameInput.value = '';
            latInput.value = '';
            lngInput.value = '';
            msgDiv.textContent = 'Click Search to validate location.';
            msgDiv.style.color = '#6c757d';
          });

          searchBtn.addEventListener('click', function () {
            var query = input.value.trim();
            if (!query) {
              msgDiv.textContent = 'Please enter a location to search.';
              msgDiv.style.color = '#dc3545';
              return;
            }

            if (!/nepal/i.test(query)) query = query + ', Nepal';

            searchBtn.disabled = true;
            searchBtn.textContent = 'Searching…';

            var geocoder = new google.maps.Geocoder();
            geocoder.geocode({ address: query }, function (results, status) {
              searchBtn.disabled = false;
              searchBtn.textContent = 'Search';

              if (status !== 'OK' || !results || results.length === 0) {
                nameInput.value = ''; latInput.value = ''; lngInput.value = '';
                msgDiv.textContent = 'Please enter a valid location in Nepal.';
                msgDiv.style.color = '#dc3545';
                return;
              }

              var loc = results[0].geometry.location;
              var lat = loc.lat(), lng = loc.lng();

              if (lat < 26.3 || lat > 30.5 || lng < 80.0 || lng > 88.5) {
                nameInput.value = ''; latInput.value = ''; lngInput.value = '';
                msgDiv.textContent = 'Please enter a valid location in Nepal.';
                msgDiv.style.color = '#dc3545';
                return;
              }

              var address = results[0].formatted_address;
              nameInput.value = address;
              latInput.value = lat;
              lngInput.value = lng;
              input.value = address;
              msgDiv.textContent = 'Location selected.';
              msgDiv.style.color = '#198754';

              // Show small map preview
              var previewDiv = document.getElementById('profileMapPreview');
              if (previewDiv && typeof google !== 'undefined') {
                previewDiv.style.display = 'block';
                var previewMap = new google.maps.Map(previewDiv, {
                  center: { lat: lat, lng: lng }, zoom: 14,
                  mapTypeControl: false, streetViewControl: false,
                  fullscreenControl: false, zoomControl: false,
                });
                new google.maps.Marker({ map: previewMap, position: { lat: lat, lng: lng } });
              }
            });
          });
        })();
      </script>