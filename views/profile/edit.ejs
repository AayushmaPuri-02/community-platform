<h2>Edit Profile</h2>

<form action="/profile/edit" method="POST" enctype="multipart/form-data">

  <div>
    <label>Bio</label><br>
    <textarea name="bio" rows="4"><%= user.bio %></textarea>
  </div>

  <div>
  <label>Contact Info</label><br>
  <input 
    type="text" 
    name="contactInfo" 
    value="<%= user.contactInfo %>"
    placeholder="e.g. +977-98XXXXXXXX, org@email.com, Sun–Fri 9AM–5PM"
  >
  <small>Include public contact details such as phone, email, office hours, or address.</small>
</div>

  <div>
    <label>Social Media Link</label><br>
    <input type="text" name="socialMediaLink" value="<%= user.socialMediaLink %>">
  </div>

  <div>
  <label>Profile Image</label><br>
  <input type="file" name="profileImage" accept=".jpg,.jpeg,.png">
</div>

  <button type="submit">Save Profile</button>
</form>