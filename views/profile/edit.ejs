<% if (role === "citizen") { %>

<div class="container py-5" style="max-width: 720px;">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">

      <h2 class="fw-bold mb-3">Edit Profile</h2>

      <p class="text-muted mb-4">
        Update your personal details and profile image.
      </p>

      <form action="/profile/edit" method="POST" enctype="multipart/form-data">

        <div class="mb-4">
          <label class="form-label fw-semibold">Full Name</label>
          <input
            type="text"
            name="fullName"
            class="form-control"
            value="<%= user.fullName || '' %>"
            placeholder="Enter your full name"
            required
          >
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Email Address</label>
          <input
            type="email"
            name="email"
            class="form-control"
            value="<%= user.email || '' %>"
            placeholder="Enter your email address"
            required
          >
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Location</label>
          <input
            type="text"
            name="location"
            class="form-control"
            value="<%= user.location || '' %>"
            placeholder="Enter your area or location"
          >
          <div class="form-text">
            Optional. Add your area so your profile looks more complete.
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Profile Image</label>
          <input
            type="file"
            name="profileImage"
            class="form-control"
            accept=".jpg,.jpeg,.png"
          >
          <div class="form-text">
            Upload a profile picture if you want to personalize your account.
          </div>

          <% if (user.profileImage) { %>
            <div class="mt-3">
              <p class="mb-2 fw-semibold">Current Image</p>
              <img
                src="<%= user.profileImage %>"
                alt="Current profile image"
                class="img-thumbnail rounded-3"
                style="max-width: 160px; max-height: 160px; object-fit: cover;"
              >
            </div>
          <% } %>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4">Save Profile</button>
          <a href="/users/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
        </div>

      </form>
    </div>
  </div>
</div>

<% } else { %>

  
<div class="container py-5" style="max-width: 760px;">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4 p-md-5">

      <h2 class="fw-bold mb-3">
        <%= user.role === "organization" || user.role === "communityAdmin" ? "Complete Profile" : "Edit Profile" %>
      </h2>

      <% if (!user.profileCompleted) { %>
        <div class="alert alert-warning mb-4">
          <strong>Complete your profile to continue.</strong><br>
          Add the required public details before accessing the platform.
        </div>
      <% } %>

      <form action="/profile/edit" method="POST" enctype="multipart/form-data">

        <div class="mb-4">
          <label class="form-label fw-semibold">Organization / Community Description</label>
          <textarea
            name="bio"
            rows="5"
            class="form-control"
            placeholder="Briefly explain who you are, what your organization does, and the kind of support, events, or services you provide."
          ><%= user.bio || "" %></textarea>
          <div class="form-text">
            Keep this short and clear. Around 2–5 sentences is enough.
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Public Contact Information</label>
          <input
            type="text"
            name="contactInfo"
            class="form-control"
            value="<%= user.contactInfo || "" %>"
            placeholder="e.g. +977-98XXXXXXXX, org@email.com, Sun–Fri 9AM–5PM"
          >
          <div class="form-text">
            Include public contact details such as phone number, public email, office hours, or address.
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Social Media / Website Link</label>
          <input
            type="text"
            name="socialMediaLink"
            class="form-control"
            value="<%= user.socialMediaLink || "" %>"
            placeholder="e.g. https://facebook.com/yourpage or https://yourwebsite.com"
          >
          <div class="form-text">
            Optional. Add a public Facebook page, Instagram page, or website.
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Profile Image</label>
          <input
            type="file"
            name="profileImage"
            class="form-control"
            accept=".jpg,.jpeg,.png"
          >
          <div class="form-text">
            Upload your organization logo or a representative profile image.
          </div>

          <% if (user.profileImage) { %>
            <div class="mt-3">
              <p class="mb-2 fw-semibold">Current Image</p>
              <img
                src="<%= user.profileImage %>"
                alt="Current profile image"
                class="img-thumbnail"
                style="max-width: 180px; max-height: 180px; object-fit: cover;"
              >
            </div>
          <% } %>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary px-4">Save Profile</button>

          <% if (user.profileCompleted) { %>
            <a href="/users/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
          <% } %>
        </div>

      </form>
    </div>
  </div>
</div>

<% } %>


