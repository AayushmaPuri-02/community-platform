<div class="modal fade" id="suspendConfirmModal" tabindex="-1" aria-labelledby="suspendConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-danger" id="suspendConfirmModalLabel">
          <i class="bi bi-slash-circle me-2"></i>Confirm Account Suspension
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body pt-2">
        <p class="mb-0" style="font-size:13.5px;line-height:1.55;">
          Are you sure you want to suspend this account? The user will not be able to log in until the account is reinstated.
        </p>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger rounded-pill px-4" id="suspendConfirmModalSubmit">
          Suspend Account
        </button>
      </div>
    </div>
  </div>
</div>
