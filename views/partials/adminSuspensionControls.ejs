<%#
  targetUser — user document with isSuspended
  returnTo — redirect URL after action
  suspendLabel — optional button label (default: Suspend Account)
  unsuspendLabel — optional (default: Unsuspend Account)
%>
<% if (targetUser && targetUser.role !== 'systemAdmin') { %>
  <% var _returnTo = typeof returnTo !== 'undefined' ? returnTo : '/admin/reports'; %>
  <% var _suspendLabel = typeof suspendLabel !== 'undefined' ? suspendLabel : 'Suspend Account'; %>
  <% var _unsuspendLabel = typeof unsuspendLabel !== 'undefined' ? unsuspendLabel : 'Unsuspend Account'; %>
  <% var _displayName = targetUser.communityName || targetUser.organizationName || targetUser.fullName || 'User'; %>

  <div class="card border-0 shadow-sm rounded-4 mb-4 admin-suspension-card">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h6 class="fw-bold mb-0" style="font-size:13px;">
          <i class="bi bi-shield-exclamation me-1 text-danger"></i>Account Suspension
        </h6>
        <% if (targetUser.isSuspended) { %>
          <span class="badge bg-danger rounded-pill px-2" style="font-size:0.72rem;">Suspended</span>
        <% } else { %>
          <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-2" style="font-size:0.72rem;">Active</span>
        <% } %>
      </div>

      <p class="text-muted small mb-3 mb-md-2" style="font-size:11.5px;line-height:1.45;">
        Suspension is applied manually by the system admin after reviewing report history and context.
        Warning counts do not trigger automatic suspension.
      </p>

      <% if (targetUser.isSuspended && targetUser.suspendedAt) { %>
        <p class="small text-muted mb-2">
          Suspended on
          <%= new Date(targetUser.suspendedAt).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
          <% if (targetUser.suspendedReason) { %>
            &middot; Reason: <%= targetUser.suspendedReason %>
          <% } %>
        </p>
      <% } %>

      <% if (targetUser.isSuspended) { %>
        <form action="/admin/users/<%= targetUser._id %>/unsuspend" method="POST" class="m-0"
          onsubmit="return confirm('Are you sure you want to unsuspend this account?');">
          <input type="hidden" name="returnTo" value="<%= _returnTo %>">
          <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" style="font-size:12px;">
            <i class="bi bi-person-check me-1"></i><%= _unsuspendLabel %>
          </button>
        </form>
      <% } else { %>
        <form action="/admin/users/<%= targetUser._id %>/suspend" method="POST" class="m-0 admin-suspend-form">
          <input type="hidden" name="returnTo" value="<%= _returnTo %>">
          <label class="form-label small fw-semibold mb-1" style="font-size:11.5px;">Suspension reason (optional)</label>
          <textarea name="suspendedReason" class="form-control form-control-sm mb-2" rows="2"
            placeholder="Brief reason for <%= _displayName %>…" maxlength="500"></textarea>
          <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 js-suspend-confirm-btn" style="font-size:12px;">
            <i class="bi bi-slash-circle me-1"></i><%= _suspendLabel %>
          </button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>
