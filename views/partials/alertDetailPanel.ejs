<aside id="alertDetailPanel" class="alert-detail-panel" aria-hidden="true" aria-label="Alert details">
  <div class="alert-detail-panel__card">
    <div class="alert-detail-panel__header">
      <div class="alert-detail-panel__header-main" id="alertDetailPanelHeader">
        <span class="text-muted" style="font-size:11.5px;">Select an alert to view details</span>
      </div>
      <button type="button" class="alert-detail-panel__close" id="alertDetailPanelClose" aria-label="Close panel">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div class="alert-detail-panel__body" id="alertDetailPanelBody">
      <div class="alert-detail-panel__placeholder text-muted text-center py-4" style="font-size:12px;">
        <i class="bi bi-cursor d-block mb-2" style="font-size:1.25rem;opacity:0.5;"></i>
        Click an alert in the list or on the map
      </div>
    </div>
  </div>
</aside>
