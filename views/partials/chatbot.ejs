<!-- Chatbot toggle button -->
<button id="chatbotToggle" title="Local Connect Assistant"
    style="position:fixed;bottom:24px;right:24px;z-index:1050;width:52px;height:52px;border-radius:50%;background:#008080;border:none;color:#fff;font-size:22px;box-shadow:0 4px 14px rgba(0,0,0,0.18);cursor:pointer;display:flex;align-items:center;justify-content:center;">
    <i class="bi bi-chat-dots-fill"></i>
</button>

<!-- Chatbot window -->
<div id="chatbotWindow"
    style="display:none;position:fixed;bottom:86px;right:24px;z-index:1050;width:320px;max-height:460px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,0.12);display:none;flex-direction:column;overflow:hidden;">

    <!-- Header -->
    <div
        style="background:#008080;color:#fff;padding:12px 16px;font-size:13.5px;font-weight:700;display:flex;align-items:center;justify-content:space-between;">
        <span><i class="bi bi-robot me-2"></i>Local Connect Assistant</span>
        <button id="chatbotClose"
            style="background:none;border:none;color:#fff;font-size:18px;cursor:pointer;line-height:1;">&times;</button>
    </div>

    <!-- Messages -->
    <div id="chatMessages"
        style="flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;min-height:200px;max-height:300px;">
        <div class="chat-msg bot"
            style="align-self:flex-start;background:#f1f5f9;color:#1e293b;padding:8px 12px;border-radius:10px;font-size:13px;max-width:85%;">
            Hi! I can help with alerts, volunteering, reporting, and how Local Connect works.
        </div>
    </div>

    <!-- Input -->
    <div style="padding:10px;border-top:1px solid #f1f5f9;display:flex;gap:6px;">
        <input id="chatInput" type="text" placeholder="Ask something..."
            style="flex:1;border:1px solid #e2e8f0;border-radius:8px;padding:7px 10px;font-size:13px;outline:none;" />
        <button id="chatSendBtn"
            style="background:#008080;color:#fff;border:none;border-radius:8px;padding:7px 13px;font-size:13px;cursor:pointer;font-weight:600;">
            Send
        </button>
    </div>
</div>

<script>
    (function () {
        var toggle = document.getElementById('chatbotToggle');
        var win = document.getElementById('chatbotWindow');
        var closeBtn = document.getElementById('chatbotClose');
        var sendBtn = document.getElementById('chatSendBtn');
        var input = document.getElementById('chatInput');
        var messages = document.getElementById('chatMessages');

        var isOpen = false;

        function openChat() {
            win.style.display = 'flex';
            isOpen = true;
            input.focus();
        }

        function closeChat() {
            win.style.display = 'none';
            isOpen = false;
        }

        toggle.addEventListener('click', function () {
            isOpen ? closeChat() : openChat();
        });

        closeBtn.addEventListener('click', closeChat);

        function appendMsg(text, role) {
            var div = document.createElement('div');
            div.style.cssText = 'padding:8px 12px;border-radius:10px;font-size:13px;max-width:85%;word-break:break-word;';
            if (role === 'user') {
                div.style.alignSelf = 'flex-end';
                div.style.background = '#008080';
                div.style.color = '#fff';
            } else {
                div.style.alignSelf = 'flex-start';
                div.style.background = '#f1f5f9';
                div.style.color = '#1e293b';
            }
            div.textContent = text;
            messages.appendChild(div);
            messages.scrollTop = messages.scrollHeight;
            return div;
        }

        function sendMessage() {
            var text = input.value.trim();
            if (!text) return;
            input.value = '';
            appendMsg(text, 'user');

            var thinking = appendMsg('Thinking…', 'bot');
            thinking.style.color = '#94a3b8';

            fetch('/api/chatbot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    thinking.textContent = data.reply || 'No response.';
                    thinking.style.color = '#1e293b';
                    messages.scrollTop = messages.scrollHeight;
                })
                .catch(function () {
                    thinking.textContent = 'Error, try again.';
                    thinking.style.color = '#dc3545';
                });
        }

        sendBtn.addEventListener('click', sendMessage);

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') sendMessage();
        });
    })();
</script>