<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .dash-recent-post {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .dash-recent-post__main {
        flex: 1 1 auto;
        min-width: 0;
    }

    .dash-recent-post__title {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }

    .dash-recent-post__date {
        flex: 0 0 auto;
        white-space: nowrap;
        text-align: right;
        line-height: 1.4;
    }
</style>

<div class="py-3 px-2">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <% if (user.role==="communityAdmin" ) { %>
                <%= user.communityName || (user.location + " Locals" ) %>
                    <% } else { %>
                        <%= user.organizationName || user.fullName %>
                            <% } %>
        </h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <% if (user.isVerified) { %>
                <span class="badge bg-success">Verified</span>
                <% } else if (user.isApproved) { %>
                    <span class="badge bg-warning text-dark">Approved — Email not verified</span>
                    <% } else { %>
                        <span class="badge bg-secondary">Pending Approval</span>
                        <% } %>
                            <% if (user.location) { %>
                                <span class="text-muted small">Area: <%= user.location %></span>
                                <% } %>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold" style="font-size:1.7rem; color:#04888D;">
                    <%= totalPosts %>
                </div>
                <div class="text-muted small">Total Posts</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold" style="font-size:1.7rem; color:#dc3545;">
                    <%= alertPosts %>
                </div>
                <div class="text-muted small">Alerts</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold" style="font-size:1.7rem; color:#f59e0b;">
                    <%= followerCount %>
                </div>
                <div class="text-muted small">Followers</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold" style="font-size:1.7rem; color:#6c757d;">
                    <%= followingCount %>
                </div>
                <div class="text-muted small">Following</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <div class="fw-bold" style="font-size:1.7rem; color:#0d6efd;">
                    <%= postsThisWeek %>
                </div>
                <div class="text-muted small">This Week</div>
            </div>
        </div>
    </div>

    <!-- BAR CHART + RECENT POSTS -->
    <div class="row g-3 mb-3 align-items-stretch">

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 h-100">
                <h6 class="fw-bold mb-2 mb-md-3">Posts by Type</h6>
                <% if (!postTypeChart || !postTypeChart.hasData) { %>
                    <div class="text-center py-4 d-flex flex-column justify-content-center" style="min-height:220px;">
                        <i class="bi bi-bar-chart-line text-muted" style="font-size:2rem;"></i>
                        <p class="text-muted small mt-2 mb-0">No posts yet. Create a post to see distribution.</p>
                    </div>
                <% } else { %>
                    <div style="position:relative; height:240px;">
                        <canvas id="postTypeChart"></canvas>
                    </div>
                    <script type="application/json" id="postTypeChartData"><%- JSON.stringify(postTypeChart) %></script>
                <% } %>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 h-100 overflow-hidden">
                <h6 class="fw-bold mb-2 mb-md-3 text-muted">Recent Posts</h6>
                <% if (recentPosts.length===0) { %>
                    <p class="text-muted small mb-0 py-3">No posts yet.</p>
                <% } else { %>
                    <% recentPosts.forEach(function(post, idx) { %>
                        <div class="dash-recent-post py-2 <%= idx < recentPosts.length - 1 ? 'border-bottom' : '' %>">
                            <div class="dash-recent-post__main">
                                <a href="/posts/<%= post._id %>"
                                    class="dash-recent-post__title text-decoration-none fw-semibold"
                                    style="color:#04888D; font-size:0.95rem;"
                                    title="<%= post.title %>">
                                    <%= post.title %>
                                </a>
                                <div class="mt-1">
                                    <span class="badge bg-light text-dark border text-capitalize"
                                        style="font-size:0.72rem;">
                                        <%= post.type %>
                                    </span>
                                </div>
                            </div>
                            <% if (post.type === 'alert') { %>
                                <small class="text-muted dash-recent-post__date"><%= formatAlertDate(post.createdAt) %></small>
                            <% } else { %>
                                <small class="text-muted dash-recent-post__date post-date"
                                    data-created="<%= post.createdAt.toISOString() %>"></small>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>

    </div>

    <!-- TOP PERFORMING + VOLUNTEER POSTS -->
    <div class="row g-3 mb-3 align-items-stretch">

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 h-100">
                <h6 class="fw-bold mb-2 mb-md-3">Top Performing Post</h6>
                <% if (!topPerformingPost) { %>
                    <div class="text-muted small py-3">
                        <i class="bi bi-graph-up-arrow me-1"></i>
                        No posts yet. Your most engaging post will appear here.
                    </div>
                <% } else { %>
                    <% var tpType = topPerformingPost.type || ''; %>
                    <% var tpTypeLabel = tpType === 'communityUpdate' ? 'Community Update' : tpType.charAt(0).toUpperCase() + tpType.slice(1); %>
                    <a href="/posts/<%= topPerformingPost._id %>" class="fw-semibold text-decoration-none d-block mb-2"
                        style="color:#04888D; font-size:0.95rem; line-height:1.45;">
                        <%= topPerformingPost.title %>
                    </a>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-light text-dark border text-capitalize" style="font-size:0.72rem;">
                            <%= tpTypeLabel %>
                        </span>
                        <small class="text-muted">
                            <%= new Date(topPerformingPost.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </small>
                    </div>
                    <ul class="list-unstyled mb-0 small">
                        <li class="d-flex align-items-center gap-2 mb-2 text-secondary">
                            <i class="bi bi-heart-fill" style="color:#dc3545;"></i>
                            <span><strong><%= topPerformingPost.likeCount %></strong> Like<%= topPerformingPost.likeCount === 1 ? '' : 's' %></span>
                        </li>
                        <li class="d-flex align-items-center gap-2 mb-2 text-secondary">
                            <i class="bi bi-chat-dots-fill" style="color:#04888D;"></i>
                            <span><strong><%= topPerformingPost.commentCount %></strong> Comment<%= topPerformingPost.commentCount === 1 ? '' : 's' %></span>
                        </li>
                        <% if (topPerformingPost.type === 'volunteer') { %>
                            <li class="d-flex align-items-center gap-2 text-secondary">
                                <i class="bi bi-people-fill" style="color:#0d6efd;"></i>
                                <span><strong><%= topPerformingPost.volunteerSignupCount %></strong> Volunteer<%= topPerformingPost.volunteerSignupCount === 1 ? '' : 's' %> Joined</span>
                            </li>
                        <% } %>
                    </ul>
                <% } %>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 h-100">
                <h6 class="fw-bold mb-2 mb-md-3 text-muted">Volunteer Posts</h6>
                <% if (!volunteerPosts || volunteerPosts.length === 0) { %>
                    <p class="text-muted small mb-0 py-2">No active volunteer posts in the last 7 days.</p>
                <% } else { %>
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="font-size:0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Signups</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% volunteerPosts.forEach(function(vp, vpIdx) { var now=new Date(); var vpDate=vp.volunteerDate
                            ? new Date(vp.volunteerDate) : null; var vpActiveCount=vp.volunteers.filter(function(v){
                            return v.status==='pending' || v.status==='attended' ; }).length; var
                            isFull=vp.maxVolunteers> 0 && vpActiveCount >= vp.maxVolunteers;
                            var isPast = vpDate && vpDate < now; var statusLabel=isPast ? "Past" : (isFull ? "Full"
                                : "Open" ); var statusClass=isPast ? "bg-secondary" : (isFull ? "bg-warning text-dark"
                                : "bg-success" ); %>
                                <tr>
                                    <td>
                                        <a href="/posts/<%= vp._id %>" class="text-decoration-none fw-semibold"
                                            style="color:#04888D;">
                                            <%= vp.title %>
                                        </a>
                                    </td>
                                    <td class="text-muted">
                                        <% if (vpDate) { %>
                                            <%= vpDate.toLocaleDateString("en-GB", { day:"numeric", month:"short",
                                                year:"numeric" }) %>
                                                <% } else { %>
                                                    —
                                                    <% } %>
                                    </td>
                                    <td class="text-muted">
                                        <%= vpActiveCount %>
                                            <% if (vp.maxVolunteers> 0) { %> / <%= vp.maxVolunteers %>
                                                    <% } %>
                                    </td>
                                    <td><span class="badge <%= statusClass %>">
                                            <%= statusLabel %>
                                        </span></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                            data-bs-toggle="modal" data-bs-target="#volModal-<%= vpIdx %>">
                                            View Volunteers
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                    </tbody>
                </table>
            </div>
                <% } %>
            </div>
        </div>

    </div>

</div>

<% if (volunteerPosts && volunteerPosts.length> 0) { %>
    <!-- Volunteer modals — one per volunteer post -->
    <% volunteerPosts.forEach(function(vp, vpIdx) { %>
        <div class="modal fade" id="volModal-<%= vpIdx %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold">
                            <%= vp.title %> — Volunteers
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <% if (vp.volunteers.filter(function(v){ return v.status !=='rejected' ; }).length===0) { %>
                            <p class="text-muted mb-0">No volunteers yet.</p>
                            <% } else { %>
                                <div class="accordion" id="dashVolAccordion-<%= vpIdx %>">
                                    <% vp.volunteers.forEach(function(v, vi) { %>
                                        <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed py-2 px-3" type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#dv-<%= vpIdx %>-<%= vi %>">
                                                    <span class="fw-semibold me-2 d-inline-flex align-items-center gap-1">
                                                        <%= v.fullName %>
                                                        <% if (v.user) { %>
                                                            <%- include('../partials/volunteerBadge', { user: v.user }) %>
                                                        <% } %>
                                                    </span>
                                                    <% var vHeaderStatus=v.status || (v.attended ? 'attended'
                                                        : 'pending' ); %>
                                                        <% if (vHeaderStatus==='attended' ) { %>
                                                            <span class="badge bg-success ms-2"
                                                                style="font-size:0.72rem;">Attended</span>
                                                            <% } else if (vHeaderStatus==='rejected' ) { %>
                                                                <span class="badge bg-danger ms-2"
                                                                    style="font-size:0.72rem;">Rejected</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-warning text-dark ms-2"
                                                                        style="font-size:0.72rem;">Pending</span>
                                                                    <% } %>
                                                </button>
                                            </h2>
                                            <div id="dv-<%= vpIdx %>-<%= vi %>" class="accordion-collapse collapse">
                                                <div class="accordion-body py-2 px-3" style="font-size:0.9rem;">
                                                    <p class="mb-1"><strong>Phone:</strong>
                                                        <%= v.phone %>
                                                    </p>
                                                    <% if (v.note) { %>
                                                        <p class="mb-1"><strong>Note:</strong>
                                                            <%= v.note %>
                                                        </p>
                                                        <% } %>
                                                            <p class="mb-2"><strong>Joined:</strong>
                                                                <%= v.joinedAt ? new
                                                                    Date(v.joinedAt).toLocaleDateString("en-GB", {
                                                                    day:"numeric", month:"long", year:"numeric" })
                                                                    : "N/A" %>
                                                            </p>
                                                            <% if (v.user) { %>
                                                                <% var volunteerUserId = v.user._id || v.user; %>
                                                                <p class="mb-2">
                                                                    <a href="/users/<%= volunteerUserId %>" target="_blank"
                                                                        class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                                        style="font-size:0.8rem;">
                                                                        <i class="bi bi-person me-1"></i>View Profile
                                                                    </a>
                                                                </p>
                                                                <% } %>
                                                                    <% var vStatus=v.status || (v.attended ? 'attended'
                                                                        : 'pending' ); var canMarkAttend=false; var
                                                                        isPastDate=false; if (vp.volunteerDate) { var
                                                                        todayD=new Date(); todayD.setHours(0,0,0,0); var
                                                                        vpD=new Date(vp.volunteerDate);
                                                                        vpD.setHours(0,0,0,0); canMarkAttend=(todayD>=
                                                                        vpD);
                                                                        isPastDate = (todayD > vpD);
                                                                        }
                                                                        %>
                                                                        <% if (vStatus==='attended' ) { %>
                                                                            <span
                                                                                class="badge bg-success px-3 py-2">Attended
                                                                                —
                                                                                Permanent</span>
                                                                            <% if (v.contributionNote) { %>
                                                                                <p class="text-muted small mt-2 mb-0">
                                                                                    <strong>Contribution Note:</strong>
                                                                                    <%= v.contributionNote %>
                                                                                </p>
                                                                                <% } %>
                                                                            <% } else if (vStatus==='rejected' ) { %>
                                                                                <span
                                                                                    class="badge bg-danger px-3 py-2">Rejected</span>
                                                                                <% if (v.rejectionReason) { %>
                                                                                    <p
                                                                                        class="text-muted small mt-1 mb-0">
                                                                                        Reason: <%= v.rejectionReason %>
                                                                                    </p>
                                                                                    <% } %>
                                                                                        <% } else { %>
                                                                                            <div
                                                                                                class="d-flex gap-2 flex-wrap align-items-start">
                                                                                                <% if (canMarkAttend) {
                                                                                                    %>
                                                                                                    <button
                                                                                                        type="button"
                                                                                                        class="btn btn-sm btn-outline-success rounded-pill px-3"
                                                                                                        data-bs-toggle="collapse"
                                                                                                        data-bs-target="#attendForm-<%= vpIdx %>-<%= vi %>">
                                                                                                        Mark as Attended
                                                                                                    </button>
                                                                                                    <div class="collapse mt-2 w-100"
                                                                                                        id="attendForm-<%= vpIdx %>-<%= vi %>">
                                                                                                        <form
                                                                                                            action="/posts/<%= vp._id %>/volunteer/<%= v._id %>/attend"
                                                                                                            method="POST"
                                                                                                            class="border rounded-3 p-3 bg-light">
                                                                                                            <input
                                                                                                                type="hidden"
                                                                                                                name="fromDashboard"
                                                                                                                value="1">
                                                                                                            <label
                                                                                                                for="contributionNote-<%= vpIdx %>-<%= vi %>"
                                                                                                                class="form-label small fw-semibold mb-1">Contribution
                                                                                                                Note
                                                                                                                <span
                                                                                                                    class="text-muted fw-normal">(optional)</span></label>
                                                                                                            <textarea
                                                                                                                id="contributionNote-<%= vpIdx %>-<%= vi %>"
                                                                                                                name="contributionNote"
                                                                                                                class="form-control form-control-sm mb-2"
                                                                                                                rows="3"
                                                                                                                maxlength="200"
                                                                                                                placeholder="Describe how this volunteer contributed..."></textarea>
                                                                                                            <div
                                                                                                                class="form-text mb-2">
                                                                                                                Max 200
                                                                                                                characters.
                                                                                                            </div>
                                                                                                            <button
                                                                                                                type="submit"
                                                                                                                class="btn btn-sm btn-success rounded-pill px-3">Confirm
                                                                                                                Attendance</button>
                                                                                                        </form>
                                                                                                    </div>
                                                                                                    <% } else { %>
                                                                                                        <button
                                                                                                            type="button"
                                                                                                            class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                                                                                            disabled>Mark
                                                                                                            as
                                                                                                            Attended</button>
                                                                                                        <div class="text-muted w-100"
                                                                                                            style="font-size:0.78rem;">
                                                                                                            Available on
                                                                                                            or
                                                                                                            after the
                                                                                                            volunteer
                                                                                                            date.</div>
                                                                                                        <% } %>
                                                                                                            <% if
                                                                                                                (!isPastDate)
                                                                                                                { %>
                                                                                                                <button
                                                                                                                    type="button"
                                                                                                                    class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                                                                                    data-bs-toggle="collapse"
                                                                                                                    data-bs-target="#rejectForm-<%= vpIdx %>-<%= vi %>">Reject</button>
                                                                                                                <div class="collapse mt-2 w-100"
                                                                                                                    id="rejectForm-<%= vpIdx %>-<%= vi %>">
                                                                                                                    <form
                                                                                                                        action="/posts/<%= vp._id %>/volunteer/<%= v._id %>/reject"
                                                                                                                        method="POST">
                                                                                                                        <input
                                                                                                                            type="hidden"
                                                                                                                            name="fromDashboard"
                                                                                                                            value="1">
                                                                                                                        <textarea
                                                                                                                            name="rejectionReason"
                                                                                                                            class="form-control form-control-sm mb-2"
                                                                                                                            rows="2"
                                                                                                                            placeholder="Reason for rejection (required)"
                                                                                                                            required></textarea>
                                                                                                                        <button
                                                                                                                            type="submit"
                                                                                                                            class="btn btn-sm btn-danger rounded-pill px-3">Confirm
                                                                                                                            Reject</button>
                                                                                                                    </form>
                                                                                                                </div>
                                                                                                                <% } %>
                                                                                            </div>
                                                                                            <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } %>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light rounded-pill px-4"
                            data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
            <% } %>

                <script>
                    document.addEventListener("DOMContentLoaded", function () {

                        // Smart date formatting
                        document.querySelectorAll('.post-date').forEach(function (el) {
                            var created = new Date(el.getAttribute('data-created'));
                            var now = new Date();
                            var isToday = created.getDate() === now.getDate() &&
                                created.getMonth() === now.getMonth() &&
                                created.getFullYear() === now.getFullYear();
                            if (isToday) {
                                el.textContent = created.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                            } else {
                                el.textContent = created.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                            }
                        });

                        // Bar chart
                        var canvas = document.getElementById('postTypeChart');
                        var chartDataEl = document.getElementById('postTypeChartData');
                        if (!canvas || !chartDataEl) return;

                        var chartData = JSON.parse(chartDataEl.textContent || '{}');
                        if (!chartData.hasData) return;

                        new Chart(canvas, {
                            type: 'bar',
                            data: {
                                labels: chartData.labels,
                                datasets: [{
                                    label: 'Posts',
                                    data: chartData.values,
                                    backgroundColor: chartData.colors,
                                    borderRadius: 6,
                                    maxBarThickness: 44
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    tooltip: {
                                        callbacks: {
                                            label: function (ctx) {
                                                var n = ctx.parsed.y;
                                                return n + (n === 1 ? ' post' : ' posts');
                                            }
                                        }
                                    }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: { stepSize: 1, precision: 0 },
                                        grid: { color: 'rgba(0,0,0,0.06)' }
                                    },
                                    x: {
                                        grid: { display: false },
                                        ticks: { font: { size: 11 } }
                                    }
                                }
                            }
                        });

                    });
                </script>